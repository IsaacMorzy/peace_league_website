-toast\" aria-live=\"polite\"> <div class=\"toast-avatar\"> <span id=\"toast-initials\">AK</span> </div> <div class=\"toast-text\"> <strong id=\"toast-name\">Someone</strong> <span id=\"toast-action\">just donated</span> <strong id=\"toast-amount\">KES 6,500</strong> <span id=\"toast-location\"></span> </div> <svg class=\"toast-icon\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z\"></path></svg> </div> <!-- Newsletter Popup (exit-intent) --> <div id=\"newsletter-popup\" class=\"fixed inset-0 z-[9998] hidden items-center justify-center p-4\" style=\"background: rgba(0,0,0,0.5); backdrop-filter: blur(4px);\"> <div class=\"bg-canvas rounded-3xl border border-hairline shadow-2xl max-w-md w-full p-8 relative overflow-hidden\"> <button id=\"newsletter-close\" class=\"absolute top-4 right-4 w-8 h-8 rounded-full bg-surface flex items-center justify-center text-steel hover:text-ink transition-colors\" aria-label=\"Close\"> <svg class=\"w-4 h-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M6 18L18 6M6 6l12 12\"></path></svg> </button> <div class=\"text-center\"> <div class=\"w-16 h-16 mx-auto rounded-2xl bg-accent/10 flex items-center justify-center mb-4\"> <svg class=\"w-8 h-8 text-accent\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z\"></path></svg> </div> <h3 class=\"text-xl font-bold text-ink mb-2\">Stay in the Loop</h3> <p class=\"text-sm text-steel mb-6\">Get monthly updates on our peace-building work, impact stories, and ways to help.</p> <form id=\"newsletter-popup-form\" class=\"flex gap-2\"> <input type=\"email\" placeholder=\"your@email.com\" required class=\"flex-1 px-4 py-3 rounded-xl border border-hairline bg-canvas text-ink text-sm focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20\"> <button type=\"submit\" class=\"px-6 py-3 bg-accent text-white font-semibold rounded-xl hover:bg-accent-deep transition-colors text-sm\">Subscribe</button> </form> <p class=\"text-xs text-steel mt-3\">No spam. Unsubscribe anytime.</p> </div> </div> </div> <!-- Newsletter Popup Script --> <script type=\"module\">(function(){var e=document.getElementById(\"newsletter-popup\"),n=document.getElementById(\"newsletter-close\"),s=document.getElementById(\"newsletter-popup-form\");e&&(localStorage.getItem(\"pleague-newsletter-dismissed\")||localStorage.getItem(\"pleague-newsletter-subscribed\")||(document.addEventListener(\"mouseout\",function(t){t.clientY<=0&&!sessionStorage.getItem(\"newsletter-shown\")&&(sessionStorage.setItem(\"newsletter-shown\",\"1\"),setTimeout(function(){e.classList.remove(\"hidden\"),e.classList.add(\"flex\")},500))}),setTimeout(function(){!sessionStorage.getItem(\"newsletter-shown\")&&!localStorage.getItem(\"pleague-newsletter-dismissed\")&&(sessionStorage.setItem(\"newsletter-shown\",\"1\"),e.classList.remove(\"hidden\"),e.classList.add(\"flex\"))},6e4),n&&n.addEventListener(\"click\",function(){e.classList.add(\"hidden\"),e.classList.remove(\"flex\"),localStorage.setItem(\"pleague-newsletter-dismissed\",\"1\")}),e.addEventListener(\"click\",function(t){t.target===e&&(e.classList.add(\"hidden\"),e.classList.remove(\"flex\"),localStorage.setItem(\"pleague-newsletter-dismissed\",\"1\"))}),s&&s.addEventListener(\"submit\",function(t){t.preventDefault();var l=s.querySelector(\"input[type=email]\").value;l&&(localStorage.setItem(\"pleague-newsletter-subscribed\",\"1\"),e.innerHTML=`<div class=\"text-center p-8\"><div class=\"w-16 h-16 mx-auto rounded-full bg-accent/10 flex items-center justify-center m