---
// Libredesk Chat Widget Component
// Peace League Africa — Context-Aware AI Agent System
// Features: Gemini AI, smart routing, lead capture, appointment booking,
// post-chat survey, multi-language, event reminders, analytics
---

<!-- Libredesk Widget Configuration -->
<script>
  window.LibredeskSettings = {
    baseURL: import.meta.env.PUBLIC_LIBREDESK_BASE_URL || 'https://libredesk-production-d083.up.railway.app',
    inboxID: import.meta.env.PUBLIC_LIBREDESK_INBOX_ID || '4a127926-e6cd-426b-afc9-b2b9ccd38b6f'
  };
</script>
<script async src="https://libredesk-production-d083.up.railway.app/widget.js"></script>

<!-- Custom Pre-Chat Form -->
<div id="pleague-prechat" class="fixed inset-0 z-[9999] hidden items-center justify-center p-4" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(4px);">
  <div class="bg-canvas rounded-3xl border border-hairline shadow-2xl max-w-md w-full overflow-hidden">
    <!-- Header -->
    <div class="bg-gradient-to-r from-accent to-accent-soft p-6 text-center">
      <div class="w-14 h-14 mx-auto rounded-full bg-white/20 flex items-center justify-center mb-3">
        <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
      </div>
      <h3 class="text-xl font-bold text-white">Welcome to Peace Bot</h3>
      <p class="text-sm text-white/80 mt-1">Tell us about yourself so we can help you better</p>
    </div>
    <!-- Form -->
    <form id="prechat-form" class="p-6 space-y-4">
      <!-- Full Name -->
      <div>
        <label for="prechat-name" class="block text-sm font-semibold text-ink mb-1">Full Name <span class="text-red-500">*</span></label>
        <input id="prechat-name" name="name" type="text" required placeholder="Enter your full name" class="w-full px-4 py-3 rounded-xl border border-hairline bg-canvas text-ink text-sm focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20" />
      </div>
      <!-- Email -->
      <div>
        <label for="prechat-email" class="block text-sm font-semibold text-ink mb-1">Email Address <span class="text-red-500">*</span></label>
        <input id="prechat-email" name="email" type="email" required placeholder="your@email.com" class="w-full px-4 py-3 rounded-xl border border-hairline bg-canvas text-ink text-sm focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20" />
      </div>
      <!-- Phone Number -->
      <div>
        <label for="prechat-phone" class="block text-sm font-semibold text-ink mb-1">Phone Number <span class="text-red-500">*</span></label>
        <input id="prechat-phone" name="phone" type="tel" required placeholder="+254 712 345 678" class="w-full px-4 py-3 rounded-xl border border-hairline bg-canvas text-ink text-sm focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20" />
      </div>
      <!-- Country -->
      <div>
        <label for="prechat-country" class="block text-sm font-semibold text-ink mb-1">Country <span class="text-red-500">*</span></label>
        <select id="prechat-country" name="country" required class="w-full px-4 py-3 rounded-xl border border-hairline bg-canvas text-ink text-sm focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20">
          <option value="">Select your country</option>
          <option value="Kenya">Kenya</option>
          <option value="Uganda">Uganda</option>
          <option value="Rwanda">Rwanda</option>
          <option value="Tanzania">Tanzania</option>
          <option value="Ethiopia">Ethiopia</option>
          <option value="DRC">Democratic Republic of Congo</option>
          <option value="South Sudan">South Sudan</option>
          <option value="Somalia">Somalia</option>
          <option value="Burundi">Burundi</option>
          <option value="Mozambique">Mozambique</option>
          <option value="Madagascar">Madagascar</option>
          <option value="Malawi">Malawi</option>
          <option value="Nigeria">Nigeria</option>
          <option value="Ghana">Ghana</option>
          <option value="South Africa">South Africa</option>
          <option value="Other">Other</option>
        </select>
      </div>
      <!-- Submit -->
      <button type="submit" class="w-full py-3 bg-accent text-white font-semibold rounded-xl hover:bg-accent-deep transition-colors">
        Start Chat
      </button>
      <p class="text-xs text-steel text-center">By continuing, you agree to our Privacy Policy</p>
    </form>
  </div>
</div>
