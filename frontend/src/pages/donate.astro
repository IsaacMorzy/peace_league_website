---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import causes from '../lib/causes-data.json';
---

<Layout title="Donate" description="Support peace-building across Africa. Your tax-deductible donation funds peace education, clean water, healthcare, and youth programs in 12 countries. Donate via M-Pesa, Card, Bank, or PayPal.">
  <Navigation />

  <main id="main-content">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://peaceleagueafrica.org" },
        { "@type": "ListItem", "position": 2, "name": "Donate", "item": "https://peaceleagueafrica.org/donate" }
      ]
    })} />

    <section class="relative text-white bg-gradient-to-br from-[#1a3d4a] via-[#16404a] to-[#0d2530] overflow-hidden py-12 lg:py-20">
      <!-- Single mint orbs (no amber, no backdrop-blur) -->
      <div class="absolute top-[-80px] right-[-80px] w-[280px] h-[280px] rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(0,212,164,0.18) 0%, transparent 70%);" aria-hidden="true"></div>
      <div class="absolute bottom-[-60px] left-[-60px] w-[200px] h-[200px] rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(0,212,164,0.05) 0%, transparent 70%);" aria-hidden="true"></div>

      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 mb-6 bg-white/8 rounded-full border border-white/15 text-xs sm:text-sm font-medium text-accent-soft">
          <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse" aria-hidden="true"></span>
          95% Goes Directly to Programs
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-semibold leading-[1.10] tracking-tight">Your Gift Rebuilds Communities</h1>
        <p class="mt-6 text-lg text-white/70 max-w-2xl mx-auto">
          KES 50 trains a peace teacher. KES 25 provides clean water for a family. KES 500 launches a youth mentorship program. Every shilling goes directly to peace-building across 12 African countries.
        </p>
      </div>
    </section>

    <section class="py-16 lg:py-20 bg-canvas">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <form
          class="bg-canvas border border-hairline rounded-2xl shadow-sm p-6 sm:p-8 lg:p-10"
          method="post"
          action="/api/method/peace_league_website.api.create_donation"
        >
          <fieldset>
            <legend id="cause-heading" class="block text-xl font-semibold text-ink mb-2">Choose an amount</legend>
            <p id="cause-sub" class="text-sm text-steel mb-6">In Kenyan Shillings. Tax-deductible. Every preset stays well under KES 2,000,000.</p>

            <div id="amount-grid" class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8" role="radiogroup" aria-label="Donation amount presets">
              <label class="amount-radio cursor-pointer">
                <input type="radio" name="amount" value="25000" data-default-label="25,000" class="peer sr-only" />
                <div class="h-14 rounded-xl border border-hairline bg-canvas text-ink font-semibold flex items-center justify-center peer-checked:border-2 peer-checked:border-accent peer-checked:bg-accent peer-checked:text-primary hover:border-accent transition-colors">25,000</div>
              </label>
              <label class="amount-radio cursor-pointer">
                <input type="radio" name="amount" value="50000" data-default-label="50,000" class="peer sr-only" checked />
                <div class="h-14 rounded-xl border-2 border-accent bg-accent text-primary font-semibold flex items-center justify-center peer-checked:border-2 peer-checked:border-accent peer-checked:bg-accent peer-checked:text-primary hover:border-accent transition-colors">50,000</div>
              </label>
              <label class="amount-radio cursor-pointer">
                <input type="radio" name="amount" value="100000" data-default-label="100,000" class="peer sr-only" />
                <div class="h-14 rounded-xl border border-hairline bg-canvas text-ink font-semibold flex items-center justify-center peer-checked:border-2 peer-checked:border-accent peer-checked:bg-accent peer-checked:text-primary hover:border-accent transition-colors">100,000</div>
              </label>
              <label class="amount-radio cursor-pointer">
                <input type="radio" name="amount" value="250000" data-default-label="250,000" class="peer sr-only" />
                <div class="h-14 rounded-xl border border-hairline bg-canvas text-ink font-semibold flex items-center justify-center peer-checked:border-2 peer-checked:border-accent peer-checked:bg-accent peer-checked:text-primary hover:border-accent transition-colors">250,000</div>
              </label>
            </div>

            <input type="hidden" name="currency" value="KES" />
            <input type="hidden" name="cause" id="cause-hidden" value="" />

            <label class="block">
              <span class="block text-sm font-medium text-ink mb-2">Or enter a custom amount (KES)</span>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-sm text-steel pointer-events-none" aria-hidden="true">KES</span>
                <input
                  type="number"
                  inputmode="decimal"
                  min="100"
                  step="100"
                  max="1950000"
                  placeholder="50000"
                  class="w-full h-12 pl-14 pr-4 rounded-xl border border-hairline bg-canvas text-ink placeholder:text-muted text-base focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-colors"
                  name="custom_amount"
                  aria-label="Custom donation amount in Kenyan Shillings"
                />
              </div>
            </label>
          </fieldset>

          <hr class="my-8 border-hairline" />

          <fieldset>
            <legend class="block text-base font-medium text-ink mb-3">How would you like to give?</legend>
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-3" role="radiogroup" aria-label="Payment method">
              <label class="payment-method relative cursor-pointer">
                <input type="radio" name="payment_method" value="MPesa" class="peer sr-only" />
                <div class="rounded-xl border border-hairline p-4 peer-checked:border-accent peer-checked:bg-accent/5 peer-focus-visible:ring-2 peer-focus-visible:ring-accent peer-focus-visible:ring-offset-2 transition-colors hover:border-accent/30">
                  <div class="text-base font-semibold text-ink">M-Pesa</div>
                  <div class="text-xs text-steel mt-1">Mobile money</div>
                </div>
              </label>
              <label class="payment-method relative cursor-pointer">
                <input type="radio" name="payment_method" value="Card" class="peer sr-only" checked />
                <div class="rounded-xl border-2 border-accent bg-accent/5 p-4 peer-checked:border-accent peer-focus-visible:ring-2 peer-focus-visible:ring-accent peer-focus-visible:ring-offset-2 transition-colors hover:border-accent/30">
                  <div class="text-base font-semibold text-ink">Card</div>
                  <div class="text-xs text-steel mt-1">Visa &middot; Mastercard</div>
                </div>
              </label>
              <label class="payment-method relative cursor-pointer">
                <input type="radio" name="payment_method" value="Bank" class="peer sr-only" />
                <div class="rounded-xl border border-hairline p-4 peer-checked:border-accent peer-checked:bg-accent/5 peer-focus-visible:ring-2 peer-focus-visible:ring-accent peer-focus-visible:ring-offset-2 transition-colors hover:border-accent/30">
                  <div class="text-base font-semibold text-ink">Bank</div>
                  <div class="text-xs text-steel mt-1">ACH &middot; Wire</div>
                </div>
              </label>
              <label class="payment-method relative cursor-pointer">
                <input type="radio" name="payment_method" value="PayPal" class="peer sr-only" />
                <div class="rounded-xl border border-hairline p-4 peer-checked:border-accent peer-checked:bg-accent/5 peer-focus-visible:ring-2 peer-focus-visible:ring-accent peer-focus-visible:ring-offset-2 transition-colors hover:border-accent/30">
                  <div class="text-base font-semibold text-ink">PayPal</div>
                  <div class="text-xs text-steel mt-1">International</div>
                </div>
              </label>
            </div>
          </fieldset>

          <hr class="my-8 border-hairline" />

          <fieldset>
            <legend class="block text-base font-medium text-ink mb-3">Your details</legend>
            <p class="text-sm text-steel mb-5">Required to issue your tax-deductible receipt and (for M-Pesa) the STK Push prompt.</p>

            <div class="space-y-4">
              <label class="block">
                <span class="block text-sm font-medium text-ink mb-1.5">Full name</span>
                <input
                  type="text"
                  name="donor_name"
                  required
                  autocomplete="name"
                  class="w-full h-12 px-4 rounded-xl border border-hairline bg-canvas text-ink placeholder:text-muted text-base focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-colors"
                  placeholder="Amina Wanjiku"
                />
              </label>

              <label class="block">
                <span class="block text-sm font-medium text-ink mb-1.5">Email</span>
                <input
                  type="email"
                  name="email"
                  required
                  autocomplete="email"
                  class="w-full h-12 px-4 rounded-xl border border-hairline bg-canvas text-ink placeholder:text-muted text-base focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-colors"
                  placeholder="amina@example.org"
                />
              </label>

              <div id="phone-row" class="hidden">
                <noscript>
                  <style>#phone-row { display: block !important; }</style>
                </noscript>
                <label class="block">
                  <span class="block text-sm font-medium text-ink mb-1.5">M-Pesa phone number</span>
                  <input
                    type="tel"
                    name="phone"
                    inputmode="tel"
                    autocomplete="tel"
                    class="w-full h-12 px-4 rounded-xl border border-hairline bg-canvas text-ink placeholder:text-muted text-base focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-colors"
                    placeholder="+254 7XX XXX XXX"
                    aria-describedby="phone-help"
                  />
                  <p id="phone-help" class="mt-1 text-xs text-steel">We will send the STK Push prompt to this number. Format: +254XXXXXXXXX or 07XXXXXXXX.</p>
                </label>
              </div>

              <label class="block">
                <span class="block text-sm font-medium text-ink mb-1.5">Message (optional)</span>
                <textarea
                  name="message"
                  rows="3"
                  maxlength="500"
                  class="w-full px-4 py-3 rounded-xl border border-hairline bg-canvas text-ink placeholder:text-muted text-base focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-colors resize-none"
                  placeholder="In memory of, in honor of, or any dedication for your receipt..."
                ></textarea>
              </label>

              <label class="flex items-start gap-2 cursor-pointer">
                <input
                  type="checkbox"
                  name="anonymous"
                  value="1"
                  class="mt-1 w-4 h-4 rounded border-hairline text-accent focus:ring-accent"
                />
                <span class="text-sm text-steel">Show my donation as anonymous on the public leaderboard.</span>
              </label>
            </div>
          </fieldset>

          <hr class="my-8 border-hairline" />

          <!-- Cloudflare Turnstile (matches nominate.astro / tickets.astro / [slug].astro wiring) -->
          <div id="cf-turnstile-widget" class="my-6 flex justify-center" style="min-height:65px"></div>
          <input type="hidden" name="cf-turnstile-response" id="cf-turnstile-token" value="" />

          <button id="donate-submit" type="submit" class="btn btn-accent btn-large w-full justify-center">
            Complete my donation
            <svg class="ml-2 w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </button>

          <p class="mt-4 text-xs text-steel text-center">
            Peace League Africa is a registered nonprofit. Donations are tax-deductible. We never sell or share your data.
          </p>
        </form>

        <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4 text-center">
          <div class="rounded-xl border border-hairline p-4">
            <div class="text-2xl font-semibold text-accent-deep">95%</div>
            <div class="text-xs text-steel mt-1">Goes directly to programs</div>
          </div>
          <div class="rounded-xl border border-hairline p-4">
            <div class="text-2xl font-semibold text-accent-deep">12</div>
            <div class="text-xs text-steel mt-1">Countries served</div>
          </div>
          <div class="rounded-xl border border-hairline p-4">
            <div class="text-2xl font-semibold text-accent-deep">1,200+</div>
            <div class="text-xs text-steel mt-1">Volunteers active</div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script id="causes-json" type="application/json" set:html={JSON.stringify(causes)} is:inline />
<script>
  // ── Phone field visibility: shown only when MPesa selected (matches server contract) ──
  function syncPhoneVisibility() {
    var checked = document.querySelector('input[name="payment_method"]:checked');
    var phoneRow = document.getElementById('phone-row');
    if (!phoneRow) return;
    var isMpesa = checked && checked.value === 'MPesa';
    phoneRow.classList.toggle('hidden', !isMpesa);
    var phoneInput = phoneRow.querySelector('input[name="phone"]');
    if (phoneInput) phoneInput.required = isMpesa;
  }
  document.querySelectorAll('input[name="payment_method"]').forEach(function (radio) {
    radio.addEventListener('change', syncPhoneVisibility);
  });
  syncPhoneVisibility();

  // ── Custom amount route: when user types a value > 0, route that under name=amount
  // (server creates a Donation record from data.amount; data.custom_amount is read but
  // not used. We disable the radios + custom_amount input so the browser POSTs only the
  // hidden override.) # ponytail: full, extend peace_league_website.api.create_donation
  // to read custom_amount with priority over the radio.
  var customAmountInput = document.querySelector('input[name="custom_amount"]');
  if (customAmountInput) {
    customAmountInput.addEventListener('input', function () {
      var v = this.value.trim();
      var radios = document.querySelectorAll('#amount-grid input[name="amount"]');
      var override = document.getElementById('custom-amount-override');
      if (v && parseFloat(v) > 0) {
        // Disable radios so they don't POST name=amount and override our hidden.
        radios.forEach(function (r) { r.disabled = true; r.checked = false; });
        if (override) {
          override.value = v;
        } else {
          var h = document.createElement('input');
          h.type = 'hidden';
          h.name = 'amount';
          h.value = v;
          h.id = 'custom-amount-override';
          this.form.appendChild(h);
        }
        // Disable custom_amount input so browser skips it from POST payload.
        this.disabled = true;
      } else {
        radios.forEach(function (r) { r.disabled = false; r.checked = r.defaultChecked; });
        if (override) override.remove();
        this.disabled = false;
      }
    });
  }

  // ── Cloudflare Turnstile (matches nominate.astro / tickets.astro / [slug].astro wiring) ──
  const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
  let cfToken = '';
  function setCfToken(t) {
    cfToken = t;
    var el = document.getElementById('cf-turnstile-token');
    if (el) el.value = t;
  }
  if (TURNSTILE_SITE_KEY) {
    window.onTurnstileLoad = function () {
      if (window.turnstile) {
        window.turnstile.render('#cf-turnstile-widget', {
          sitekey: TURNSTILE_SITE_KEY,
          callback: setCfToken,
          'error-callback': function () { setCfToken(''); },
          'expired-callback': function () { setCfToken(''); },
        });
      }
    };
    var s = document.createElement('script');
    s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onTurnstileLoad';
    s.async = true;
    s.defer = true;
    document.head.appendChild(s);
  }

  // ── Submit guard: block if Turnstile required but not completed ──
  var submitForm = document.querySelector('form');
  if (submitForm) {
    submitForm.addEventListener('submit', function (e) {
      if (TURNSTILE_SITE_KEY && !cfToken) {
        e.preventDefault();
        var btn = document.getElementById('donate-submit');
        if (btn) {
          btn.textContent = 'Complete the security check below';
          btn.classList.add('opacity-60');
          setTimeout(function () {
            btn.textContent = 'Complete my donation';
            btn.classList.remove('opacity-60');
          }, 3500);
        }
        var widget = document.getElementById('cf-turnstile-widget');
        if (widget) widget.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  }

  // Per-cause amount preset scaler.
  // Reads ?cause=<name> from the URL. If present, looks up the cause in the
  // inlined causes-data island and rescales the 4 amount radios to 1% / 5% /
  // 10% / 25% of goal_amount (rounded to nice tiers, capped at KES 1,950,000).
  // # ponytail: full, swap to Frappe API call (peace_league_website.api.get_cause) once cause data lives server-side.
  (function () {
    var all = [];
    try { all = JSON.parse(document.getElementById('causes-json')?.textContent || '[]'); } catch (e) { return; }
    var params = new URLSearchParams(window.location.search);
    var cause = params.get('cause');
    if (!cause) return;
    var row = all.find(function (c) {
      return (c.name || '').toLowerCase() === cause.toLowerCase()
          || (c.title || '').toLowerCase() === cause.toLowerCase();
    });
    if (!row || !row.goal_amount) return;

    var goal = Number(row.goal_amount);
    var tiers = [0.01, 0.05, 0.10, 0.25];
    var cap = 1_950_000;
    function pretty(n) {
      if (n >= 1_000_000) return Math.min(Math.round(n / 50_000) * 50_000, cap);
      if (n >= 100_000)   return Math.min(Math.round(n / 25_000) * 25_000, cap);
      if (n >= 10_000)    return Math.min(Math.round(n / 5_000)  * 5_000,  cap);
      return Math.max(Math.round(n / 1_000) * 1_000, 1_000);
    }
    // When goal * 0.10 >= cap (Emergency Relief, Climate Resilience, Disaster Prep,
    // Tree Planting etc.) the per-% ladder collapses -- two adjacent radios would show
    // 1,950,000 stacked. Fall back to a fixed distinguishing ladder that stays well
    // under the 2M hard cap and never produces duplicate presets.
    var useFixedLadder = (goal * 0.10) >= cap;
    function presetValues(g) {
      if (useFixedLadder) return [50000, 250000, 500000, 1000000];
      var out = [];
      for (var i = 0; i < tiers.length; i++) out.push(pretty(g * tiers[i]));
      return out;
    }
    var remaining = Math.max(goal - (Number(row.raised_amount) || 0), 0);
    var note = useFixedLadder
      ? 'KES ' + remaining.toLocaleString() + ' still needed. Goal exceeds the 2M-per-gift ceiling, so presets use a fixed ladder (50K / 250K / 500K / 1M).'
      : 'KES ' + remaining.toLocaleString() + ' still needed. Presets are 1% / 5% / 10% / 25% of the KES '
        + goal.toLocaleString() + ' goal, capped at KES 1,950,000.';
    document.getElementById('cause-heading').textContent = 'Donate to ' + row.title;
    document.getElementById('cause-sub').textContent = note;
    document.getElementById('cause-hidden').value = row.title;

    var radios = document.querySelectorAll('#amount-grid input[type=radio]');
    var values = presetValues(goal);
    radios.forEach(function (input, i) {
      var amt = values[i];
      input.value = String(amt);
      var lbl = input.closest('label').querySelector('div');
      lbl.textContent = amt.toLocaleString();
      if (i === 1) input.checked = true;
    });
  })();
</script>
