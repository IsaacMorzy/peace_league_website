---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const siteUrl = Astro.site?.toString() ?? "https://peaceleagueafrica.org/";
const awardsEventSchema = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": "Peace League Africa Awards 2026",
  "description": "Awards ceremony celebrating champions of peace-building, community service, and leadership across East Africa.",
  "startDate": "2026-12-17T10:00:00+03:00",
  "endDate": "2026-12-17T15:00:00+03:00",
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "location": {
    "@type": "Place",
    "name": "August 7th Memorial Park",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Uhuru Highway next to Cooperative Bank",
      "addressLocality": "Nairobi",
      "addressCountry": "KE"
    }
  },
  "organizer": {
    "@type": "Organization",
    "name": "Peace League Africa",
    "url": siteUrl
  },
  "offers": {
    "@type": "Offer",
    "url": siteUrl + "awards/tickets",
    "price": "3500",
    "priceCurrency": "KES",
    "availability": "https://schema.org/InStock"
  }
};
---

<Layout title="Peace League Awards 2026" description="Browse categories, vote for nominees, and celebrate excellence in peace-building across Africa. Awards announced December 5, 2026.">
  <Fragment slot="jsonld">
    <script type="application/ld+json" set:html={JSON.stringify(awardsEventSchema)}></script>
  </Fragment>
  <Navigation />

  <main id="main-content" class="min-h-screen">
    <!-- Hero: dramatic gradient with depth [baseline-ui + fixing-motion-performance] -->
    <section aria-labelledby="awards-hero" class="relative py-section-lg px-4 sm:px-6 lg:px-8 overflow-hidden" style="background: linear-gradient(135deg, #0d2530 0%, #1a3d4a 40%, #0d2530 100%);">
      <!-- Ambient glow orbs -->
      <div class="absolute -top-40 -right-40 w-80 h-80 rounded-full opacity-20" style="background: radial-gradient(circle, rgba(0,212,164,0.3) 0%, transparent 70%);"></div>
      <div class="absolute -bottom-40 -left-40 w-96 h-96 rounded-full opacity-10" style="background: radial-gradient(circle, rgba(0,212,164,0.2) 0%, transparent 70%);"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] rounded-full opacity-[0.03]" style="background: radial-gradient(circle, #fff 0%, transparent 70%);"></div>

      <!-- Decorative award geometry -->
      <div class="absolute top-10 right-10 text-8xl opacity-[0.04] pointer-events-none select-none" aria-hidden="true">🏆</div>
      <div class="absolute bottom-10 left-10 text-6xl opacity-[0.03] pointer-events-none select-none" aria-hidden="true">⭐</div>

      <div class="max-w-7xl mx-auto text-center relative z-10">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur-md rounded-full text-accent-soft font-semibold text-sm mb-6 border border-white/10 animate-in fade-in slide-in-from-bottom-4 duration-700">
          <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
          2026 Awards Gala
        </div>
        <h1 id="awards-hero" class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 max-w-4xl mx-auto leading-tight tracking-tight" style="text-shadow: 0 2px 20px rgba(0,0,0,0.3);">
          Peace League Africa<br class="hidden sm:block" /> <span class="text-accent-soft">Awards</span> 2026
        </h1>
        <p class="text-lg sm:text-xl text-white/70 mb-8 max-w-2xl mx-auto font-light">
          Celebrating the champions of peace-building, community service, and leadership
          across East Africa and the Great Lakes region.
        </p>

        <!-- Countdown with glass-morphism cards -->
        <div class="flex justify-center gap-3 sm:gap-5 mb-10" id="countdown" role="timer" aria-live="off" aria-label="Countdown to awards ceremony on December 17, 2026">
          <div class="px-4 sm:px-6 py-4 min-w-[80px] sm:min-w-[100px] rounded-2xl backdrop-blur-xl border border-white/10" style="background: rgba(255,255,255,0.06);">
            <div class="text-3xl sm:text-4xl font-bold text-white" id="countdown-days" style="text-shadow: 0 0 20px rgba(0,212,164,0.3);">—</div>
            <div class="text-xs text-white/50 uppercase tracking-wider mt-1 font-medium">Days</div>
          </div>
          <div class="px-4 sm:px-6 py-4 min-w-[80px] sm:min-w-[100px] rounded-2xl backdrop-blur-xl border border-white/10" style="background: rgba(255,255,255,0.06);">
            <div class="text-3xl sm:text-4xl font-bold text-white" id="countdown-hours" style="text-shadow: 0 0 20px rgba(0,212,164,0.3);">—</div>
            <div class="text-xs text-white/50 uppercase tracking-wider mt-1 font-medium">Hours</div>
          </div>
          <div class="px-4 sm:px-6 py-4 min-w-[80px] sm:min-w-[100px] rounded-2xl backdrop-blur-xl border border-white/10" style="background: rgba(255,255,255,0.06);">
            <div class="text-3xl sm:text-4xl font-bold text-white" id="countdown-minutes" style="text-shadow: 0 0 20px rgba(0,212,164,0.3);">—</div>
            <div class="text-xs text-white/50 uppercase tracking-wider mt-1 font-medium">Minutes</div>
          </div>
          <div class="px-4 sm:px-6 py-4 min-w-[80px] sm:min-w-[100px] rounded-2xl backdrop-blur-xl border border-white/10" style="background: rgba(255,255,255,0.06);">
            <div class="text-3xl sm:text-4xl font-bold text-white" id="countdown-seconds" style="text-shadow: 0 0 20px rgba(0,212,164,0.3);">—</div>
            <div class="text-xs text-white/50 uppercase tracking-wider mt-1 font-medium">Seconds</div>
          </div>
        </div>

        <!-- CTAs -->
        <div class="flex flex-wrap justify-center gap-4">
          <a href="#categories" class="inline-flex items-center gap-2 px-6 py-3 bg-accent text-[#0a0a0a] font-semibold rounded-full hover:bg-accent-deep transition-all shadow-xl shadow-accent/25 hover:shadow-2xl hover:shadow-accent/40 group">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"/></svg>
            View Nominees
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <a href="/awards/nominate" class="inline-flex items-center gap-2 px-6 py-3 border-2 border-white/30 text-white font-semibold rounded-full hover:bg-white/10 hover:border-white/50 transition-all">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
            Nominate Someone
          </a>
          <a href="/awards/program" class="inline-flex items-center gap-2 px-6 py-3 border-2 border-white/15 text-white/80 font-semibold rounded-full hover:bg-white/5 hover:border-white/30 hover:text-white transition-all">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            View Programme
          </a>
        </div>

        <!-- Event details with glass style -->
        <dl class="flex flex-wrap justify-center gap-4 sm:gap-6 mt-10 text-sm text-white/60">
          <div class="flex items-center gap-2 px-4 py-2 rounded-full backdrop-blur-sm border border-white/5" style="background: rgba(255,255,255,0.05);">
            <svg class="w-4 h-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <dt class="sr-only">Date</dt><dd>17 Dec 2026</dd>
          </div>
          <div class="flex items-center gap-2 px-4 py-2 rounded-full backdrop-blur-sm border border-white/5" style="background: rgba(255,255,255,0.05);">
            <svg class="w-4 h-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <dt class="sr-only">Venue</dt><dd>August 7th Memorial Park, Nairobi</dd>
          </div>
          <div class="flex items-center gap-2 px-4 py-2 rounded-full backdrop-blur-sm border border-white/5" style="background: rgba(255,255,255,0.05);">
            <svg class="w-4 h-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <dt class="sr-only">Time</dt><dd>10:00 AM EAT</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- Stats Bar: Glass-morphism with animated counters -->
    <section aria-labelledby="awards-stats" class="py-10 px-4 sm:px-6 lg:px-8 border-b border-hairline" style="background: linear-gradient(180deg, #0d2530 0%, #f7f7f7 100%);">
      <div class="max-w-7xl mx-auto">
        <h2 id="awards-stats" class="sr-only">Awards statistics at a glance</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
          <div class="scroll-reveal rounded-2xl p-5 relative overflow-hidden backdrop-blur-sm border border-white/10" style="background: rgba(255,255,255,0.08);">
            <div class="text-4xl font-bold text-accent-soft stat-counter" id="stat-categories" data-target="62">0</div>
            <div class="text-sm text-white/70 mt-1 font-medium">Award Categories</div>
            <div class="absolute -top-4 -right-4 text-5xl opacity-[0.06]" aria-hidden="true">🏆</div>
          </div>
          <div class="scroll-reveal rounded-2xl p-5 relative overflow-hidden backdrop-blur-sm border border-white/10" style="background: rgba(255,255,255,0.08);">
            <div class="text-4xl font-bold text-accent-soft stat-counter" id="stat-nominees" data-target="248">0</div>
            <div class="text-sm text-white/70 mt-1 font-medium">Nominees</div>
            <div class="absolute -top-4 -right-4 text-5xl opacity-[0.06]" aria-hidden="true">👥</div>
          </div>
          <div class="scroll-reveal rounded-2xl p-5 relative overflow-hidden backdrop-blur-sm border border-white/10" style="background: rgba(255,255,255,0.08);">
            <div class="text-4xl font-bold text-accent-soft stat-counter" id="stat-votes" data-target="15420">0</div>
            <div class="text-sm text-white/70 mt-1 font-medium">Votes Cast</div>
            <div class="absolute -top-4 -right-4 text-5xl opacity-[0.06]" aria-hidden="true">🗳️</div>
          </div>
          <div class="scroll-reveal rounded-2xl p-5 relative overflow-hidden backdrop-blur-sm border border-white/10" style="background: rgba(255,255,255,0.08);">
            <div class="text-4xl font-bold text-accent-soft" id="stat-ceremony-countdown-days">—</div>
            <div class="text-sm text-white/70 mt-1 font-medium">Days to Ceremony</div>
            <div class="absolute -top-4 -right-4 text-5xl opacity-[0.06]" aria-hidden="true">📅</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Dismissible Alert (Preline) -->
    <div id="voting-alert" class="bg-accent/10 border-b border-accent/20" role="alert">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-between">
        <div class="flex items-center gap-2 text-sm text-ink">
          <span>⏳</span>
          <span>Voting closes <strong>December 5, 2026</strong>. Every vote counts — cast yours today!</span>
        </div>
        <div class="flex items-center gap-3">
          <a href="#categories" class="text-xs font-semibold text-accent hover:text-accent-deep transition-colors">Vote now →</a>
          <button type="button" class="size-6 inline-flex justify-center items-center rounded-full text-steel hover:text-ink hover:bg-hairline transition-colors" onclick="document.getElementById('voting-alert').remove()" aria-label="Dismiss">
            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Categories Grid -->
    <section aria-labelledby="awards-categories" id="categories" class="py-section px-4 sm:px-6 lg:px-8 bg-surface">
      <div class="max-w-7xl mx-auto">
        <div class="mb-8 flex flex-col sm:flex-row justify-between sm:items-end gap-4">
          <div>              <h2 id="awards-categories" class="text-3xl sm:text-4xl font-bold text-ink tracking-tight">Award Categories</h2>
            <p class="text-lg text-steel mt-2">Browse all categories and cast your vote</p>
          </div>
          <div class="flex gap-2">
            <input type="search" id="category-search" placeholder="🔍 Search categories…" class="px-4 py-2.5 rounded-full border border-hairline bg-canvas text-ink text-sm w-full sm:w-56 focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all" />
            <!-- Preline Dropdown for sort -->
            <div class="hs-dropdown relative inline-flex">
              <button type="button" class="hs-dropdown-toggle input-focus-ring px-4 py-2.5 rounded-full border border-hairline bg-canvas text-ink text-sm flex items-center gap-1.5 hover:border-accent/40 transition-colors">
                Sort
                <svg class="size-3.5 text-steel transition-transform group-data-[hs-dropdown-open]:rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 9-7 7-7-7"/></svg>
              </button>
              <div class="hs-dropdown-menu hidden transition-[opacity,margin] duration-200 opacity-0 absolute right-0 top-full mt-2 min-w-48 bg-canvas rounded-xl border border-hairline shadow-lg z-20 p-1.5" role="menu">
                <button type="button" class="sort-option flex w-full items-center gap-x-3 py-2 px-3 rounded-lg text-sm text-steel hover:bg-surface hover:text-ink transition-colors" data-sort="name">
                  <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
                  Name (A–Z)
                </button>
                <button type="button" class="sort-option flex w-full items-center gap-x-3 py-2 px-3 rounded-lg text-sm text-steel hover:bg-surface hover:text-ink transition-colors" data-sort="nominees">
                  <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                  Most Nominees
                </button>
                <button type="button" class="sort-option flex w-full items-center gap-x-3 py-2 px-3 rounded-lg text-sm text-steel hover:bg-surface hover:text-ink transition-colors" data-sort="index">
                  <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h10a2 2 0 012 2v1m-6 14h6m-3-5h3m-3-10h3"/></svg>
                  Default Order
                </button>
              </div>
            </div>
          </div>
        </div>
        <div class="relative group/carousel">
          <!-- Carousel navigation arrows -->
          <button type="button" id="carousel-prev" class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-3 z-10 size-10 rounded-full bg-canvas border border-hairline shadow-md flex items-center justify-center text-steel hover:text-ink hover:border-accent/40 opacity-100 transition-opacity duration-300 disabled:opacity-0 disabled:cursor-not-allowed" aria-label="Previous categories">
            <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <button type="button" id="carousel-next" class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-3 z-10 size-10 rounded-full bg-canvas border border-hairline shadow-md flex items-center justify-center text-steel hover:text-ink hover:border-accent/40 opacity-100 transition-opacity duration-300 disabled:opacity-0 disabled:cursor-not-allowed" aria-label="Next categories">
            <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </button>

          <div id="categories-carousel" class="flex gap-5 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-4 -mx-2 px-2" role="region" aria-label="Award categories carousel" style="scrollbar-width: thin; scrollbar-color: var(--color-accent) var(--color-hairline);">
            <div class="flex-shrink-0 w-full text-center text-steel py-12" id="categories-loading">Loading categories…</div>
          </div>
        </div>
        <div id="categories-empty" class="hidden text-center text-steel py-12">
          <div class="text-4xl mb-4">🔍</div>
          <p>No categories found matching your search.</p>
        </div>
        <div id="categories-error" class="hidden text-center text-brand-error py-12">
          Unable to load categories. Please refresh the page.
        </div>
        <!-- Carousel scroll indicator dots - always visible -->
        <div id="carousel-dots" class="flex justify-center gap-2 mt-4 min-h-[12px]" role="tablist" aria-label="Category pages"></div>
      </div>
    </section>

    <!-- How It Works: Visual step flow with connectors -->
    <section aria-labelledby="awards-how-it-works" class="py-section px-4 sm:px-6 lg:px-8 bg-surface relative overflow-hidden">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[600px] rounded-full opacity-[0.03] pointer-events-none" style="background: radial-gradient(circle, var(--color-accent) 0%, transparent 70%);"></div>
      <div class="max-w-7xl mx-auto relative z-10">
        <div class="text-center mb-12">
          <div class="inline-flex items-center gap-2 px-4 py-2 bg-accent/10 rounded-full text-accent-deep font-semibold text-sm mb-4">
            <span aria-hidden="true">✨</span> How to Participate
          </div>
          <h2 id="awards-how-it-works" class="text-3xl sm:text-4xl font-bold text-ink mb-4 tracking-tight">Three Simple Steps</h2>
          <p class="text-lg text-steel max-w-xl mx-auto">From nomination to celebration — here's how the awards work</p>
        </div>
        <div class="relative">
          <!-- Desktop connecting line -->
          <div class="hidden md:block absolute top-24 left-[16.67%] right-[16.67%] h-0.5 bg-gradient-to-r from-accent/20 via-accent/40 to-accent/20" aria-hidden="true"></div>
          <ol class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-6 list-none">
            <li class="text-center scroll-reveal group">
              <div class="relative inline-flex mb-5">
                <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-accent to-accent-deep flex items-center justify-center shadow-lg shadow-accent/20 group-hover:shadow-xl group-hover:shadow-accent/30 group-hover:-translate-y-1 transition-all duration-300">
                  <span class="text-3xl font-bold text-white">01</span>
                </div>
                <div class="absolute -top-2 -right-2 w-8 h-8 rounded-full bg-canvas border-2 border-accent/30 flex items-center justify-center shadow-sm">
                  <svg class="w-4 h-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                </div>
              </div>
              <h3 class="text-xl font-bold text-ink mb-2">Browse Nominees</h3>
              <p class="text-sm text-steel max-w-xs mx-auto leading-relaxed">Explore categories and discover the champions of peace-building across Africa making a real difference.</p>
            </li>
            <li class="text-center scroll-reveal group" style="animation-delay: 100ms">
              <div class="relative inline-flex mb-5">
                <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-accent to-accent-deep flex items-center justify-center shadow-lg shadow-accent/20 group-hover:shadow-xl group-hover:shadow-accent/30 group-hover:-translate-y-1 transition-all duration-300">
                  <span class="text-3xl font-bold text-white">02</span>
                </div>
                <div class="absolute -top-2 -right-2 w-8 h-8 rounded-full bg-canvas border-2 border-accent/30 flex items-center justify-center shadow-sm">
                  <svg class="w-4 h-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                </div>
              </div>
              <h3 class="text-xl font-bold text-ink mb-2">Cast Your Vote</h3>
              <p class="text-sm text-steel max-w-xs mx-auto leading-relaxed">Vote for your favourite nominees. One vote per category — it's free, fast, and open to everyone.</p>
            </li>
            <li class="text-center scroll-reveal group" style="animation-delay: 200ms">
              <div class="relative inline-flex mb-5">
                <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-accent to-accent-deep flex items-center justify-center shadow-lg shadow-accent/20 group-hover:shadow-xl group-hover:shadow-accent/30 group-hover:-translate-y-1 transition-all duration-300">
                  <span class="text-3xl font-bold text-white">03</span>
                </div>
                <div class="absolute -top-2 -right-2 w-8 h-8 rounded-full bg-canvas border-2 border-accent/30 flex items-center justify-center shadow-sm">
