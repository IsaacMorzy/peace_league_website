<script>
  import { getAwardCategories } from '../lib/api.js';

  let allCategories = [];

  // Countdown timer
  const TARGET_DATE = new Date('2026-12-17T10:00:00+03:00');

  function updateCountdown() {
    const now = new Date();
    const diff = TARGET_DATE - now;
    if (diff <= 0) {
      ['days','hours','minutes','seconds'].forEach(id => {
        const el = document.getElementById('countdown-' + id);
        if (el) el.textContent = '00';
      });
      return;
    }
    document.getElementById('countdown-days').textContent = String(Math.floor(diff / 86400000)).padStart(2, '0');
    document.getElementById('countdown-hours').textContent = String(Math.floor((diff % 86400000) / 3600000)).padStart(2, '0');
    document.getElementById('countdown-minutes').textContent = String(Math.floor((diff % 3600000) / 60000)).padStart(2, '0');
    document.getElementById('countdown-seconds').textContent = String(Math.floor((diff % 60000) / 1000)).padStart(2, '0');
  }
  updateCountdown();
  setInterval(updateCountdown, 1000);

  // Ceremony days remaining (static, updated on load)
  const ceremonyDate = new Date('2026-12-17T10:00:00+03:00');
  const ceremonyDaysEl = document.getElementById('stat-ceremony-countdown-days');
  if (ceremonyDaysEl) {
    const diff = ceremonyDate - new Date();
    ceremonyDaysEl.textContent = diff > 0 ? Math.ceil(diff / 86400000).toLocaleString() : '0';
  }

  // IntersectionObserver: animate stat counters when scrolled into view
  function animateCount(el, target, duration = 1200) {
    const start = parseFloat(el.dataset.start) || 0;
    const startTime = performance.now();
    function tick(now) {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = Math.floor(start + (target - start) * eased).toLocaleString();
      if (progress < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  let statCountersAnimated = false;

  function initStatCounters() {
    if (statCountersAnimated) return;
    statCountersAnimated = true;

    document.querySelectorAll('.stat-counter[data-target]').forEach(el => {
      const target = parseInt(el.dataset.target);
      if (!isNaN(target)) animateCount(el, target);
    });

  }

  // Set up IntersectionObserver for stat counters section
  const statsSection = document.querySelector('.stat-counter');
  if (statsSection && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          initStatCounters();
          observer.disconnect();
        }
      });
    }, { threshold: 0.3 });
    observer.observe(statsSection);
  } else {
    // Fallback: animate immediately
    initStatCounters();
  }

  async function loadCategories() {
    try {
      const res = await getAwardCategories();
      if (res.status !== 'success' || !res.data) throw new Error(res.message || 'API error');
      allCategories = res.data;
      // Stat counters are animated via IntersectionObserver; just update data-target
      document.getElementById('stat-categories').dataset.target = String(allCategories.length);
      renderCategories(allCategories);
    } catch (err) {
      console.error('Awards load error:', err);
      document.getElementById('categories-loading').classList.add('hidden');
      document.getElementById('categories-error').classList.remove('hidden');
    }
  }

  function renderCategories(cats) {
    const carousel = document.getElementById('categories-carousel');
    const loading = document.getElementById('categories-loading');
    const empty = document.getElementById('categories-empty');
    const error = document.getElementById('categories-error');
    const dots = document.getElementById('carousel-dots');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');
    loading.classList.add('hidden');
    error.classList.add('hidden');
    if (!cats.length) { empty.classList.remove('hidden'); dots.innerHTML = ''; return; }
    empty.classList.add('hidden');

    // Build carousel slides — ~4 cards per slide on desktop, 1 on mobile
    const cardsPerSlide = window.innerWidth < 640 ? 1 : window.innerWidth < 1024 ? 2 : window.innerWidth < 1280 ? 3 : 4;
    const slides = [];
    for (let i = 0; i < cats.length; i += cardsPerSlide) {
      slides.push(cats.slice(i, i + cardsPerSlide));
    }

    carousel.innerHTML = slides.map((slide, slideIdx) => `
      <div class="flex-shrink-0 w-full snap-start grid gap-5" style="grid-template-columns: repeat(${Math.min(cardsPerSlide, slide.length)}, 1fr)">          ${slide.map((cat) => {
          const icon = getCategoryIcon(cat.category_name);
          return `
          <div class="relative group snap-start min-w-0">
            <a href="/awards/category/${encodeURIComponent(cat.slug)}"
               class="block relative overflow-hidden rounded-2xl border border-hairline bg-canvas p-5 flex flex-col gap-2.5 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-accent/30"
               style="transform-style: preserve-3d;">
              <!-- Gradient border glow on hover -->
              <div class="pointer-events-none absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500" style="border: 1.5px solid transparent; background: linear-gradient(135deg, #00d4a4, #7cebcb, #00d4a4) border-box; -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0); -webkit-mask-composite: xor; mask-composite: exclude;"></div>

              <!-- Decorative icon background -->
              <div class="absolute -top-6 -right-6 text-7xl opacity-[0.06] pointer-events-none select-none">${icon}</div>

              <div class="flex items-start justify-between gap-2 relative z-10">
                <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-gradient-to-br from-accent/20 to-accent/5 text-xl shrink-0" aria-hidden="true">${icon}</span>
                <span class="text-xs font-medium text-steel bg-surface px-2.5 py-1 rounded-full whitespace-nowrap border border-hairline">${cat.nominee_count || 0} nominee${cat.nominee_count !== 1 ? 's' : ''}</span>
              </div>

              <h3 class="text-sm font-semibold text-ink line-clamp-2 group-hover:text-accent transition-colors leading-snug relative z-10">${escapeHtml(cat.category_name)}</h3>

              <p class="text-xs text-steel line-clamp-2 flex-1 leading-relaxed relative z-10">${escapeHtml(cat.description ? (cat.description.length > 100 ? cat.description.slice(0, 100) + '…' : cat.description) : 'No description available.')}</p>

              <div class="flex items-center gap-2 pt-3 border-t border-hairline mt-auto relative z-10">
                <span class="flex-1 text-xs font-semibold text-accent group-hover:translate-x-1 transition-transform">View & Vote →</span>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-accent/10 rounded-full text-[10px] font-bold text-accent-deep">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                  Vote
                </span>
              </div>
            </a>
          </div>
        `}).join('')}
      </div>
    `).join('');

    // Build dots
    dots.innerHTML = slides.map((_, i) => `
      <button type="button" class="carousel-dot size-2 rounded-full bg-hairline hover:bg-accent/40 transition-all duration-300 ${i === 0 ? 'bg-accent size-2.5' : ''}" data-slide="${i}" role="tab" aria-label="Go to slide ${i + 1}" aria-selected="${i === 0}"></button>
    `).join('');

    // ── Carousel navigation ──
    function updateNav() {
      const scrollLeft = carousel.scrollLeft;
      const scrollWidth = carousel.scrollWidth - carousel.clientWidth;
      const currentSlide = Math.round(scrollLeft / carousel.clientWidth);
      prevBtn.disabled = scrollLeft <= 5;
      nextBtn.disabled = scrollLeft >= scrollWidth - 5;
      // Update dots
      dots.querySelectorAll('.carousel-dot').forEach((dot, i) => {
        dot.classList.toggle('bg-accent', i === currentSlide);
        dot.classList.toggle('size-2.5', i === currentSlide);
        dot.classList.toggle('bg-hairline', i !== currentSlide);
        dot.setAttribute('aria-selected', i === currentSlide ? 'true' : 'false');
      });
    }

    prevBtn.addEventListener('click', () => {
      carousel.scrollBy({ left: -carousel.clientWidth, behavior: 'smooth' });
    });
    nextBtn.addEventListener('click', () => {
      carousel.scrollBy({ left: carousel.clientWidth, behavior: 'smooth' });
    });
    carousel.addEventListener('scroll', updateNav);
    dots.addEventListener('click', (e) => {
      const dot = e.target.closest('.carousel-dot');
      if (!dot) return;
      const slideIdx = parseInt(dot.dataset.slide);
      carousel.scrollTo({ left: slideIdx * carousel.clientWidth, behavior: 'smooth' });
    });

    // Keyboard nav
    carousel.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { prevBtn.click(); e.preventDefault(); }
      if (e.key === 'ArrowRight') { nextBtn.click(); e.preventDefault(); }
    });
    carousel.setAttribute('tabindex', '0');

    updateNav();
  }

  function getCategoryIcon(name) {
    const n = name.toLowerCase();
    if (/peace|radical|terror|extrem/i.test(n)) return '🛡️';
    if (/diplomacy|diplomat|governance|border/i.test(n)) return '🤝';
    if (/military|army|defence|defense|combat|soldier/i.test(n)) return '🎖️';
    if (/women|woman|gender|girls|female/i.test(n)) return '✊';
    if (/labour|labor|worker|trade union/i.test(n)) return '👷';
    if (/legal|lawyer|judge|justice|reform|constitution/i.test(n)) return '⚖️';
    if (/police|policing|security|law enforcement/i.test(n)) return '👮';
    if (/teacher|education|school|teaching|classroom/i.test(n)) return '📚';
    if (/health|medical|doctor|nurse|hospital|clinical/i.test(n)) return '🏥';
    if (/youth|young|student|teen/i.test(n)) return '🌱';
    if (/environment|climate|conservation|wildlife|forest/i.test(n)) return '🌿';
    if (/journalism|media|press|broadcast|reporter/i.test(n)) return '📰';
    if (/sport|athlete|football|soccer|rugby|stadium/i.test(n)) return '⚽';
    if (/art|culture|music|artist|dance|theatre/i.test(n)) return '🎨';
    if (/innovation|technology|tech|startup|digital|scien/i.test(n)) return '💡';
    if (/humanitarian|relief|aid|disaster|emergency/i.test(n)) return '🤲';
    if (/community service|volunteer|social work/i.test(n)) return '❤️';
    if (/leadership|leader|excellence/i.test(n)) return '👑';
    if (/human rights|prosecut|torture/i.test(n)) return '✊';
    if (/child|children|orphan|baby|infant/i.test(n)) return '👶';
    if (/disability|inclusion|special needs/i.test(n)) return '♿';
    if (/agriculture|farmer|farming|food security|crops/i.test(n)) return '🌾';
    if (/business|entrepreneur|enterprise|trade|commerce/i.test(n)) return '💼';
    if (/religion|faith|interfaith|pastor|imam|church|mosque|cler/i.test(n)) return '🙏';
    if (/peacebuilding|conflict resol|mediation|reconciliation/i.test(n)) return '🕊️';
    if (/democracy|election|voting|parliament|civic/i.test(n)) return '🗳️';
    if (/refugee|migration|displaced|asylum/i.test(n)) return '🏠';
    if (/indigenous|traditional|cultural heritage|elder/i.test(n)) return '🏺';
    if (/water|sanitation|hygiene/i.test(n)) return '💧';
    if (/maritime|ocean|fishing|coastal|sea/i.test(n)) return '🌊';
    if (/cyber|internet|online|data protection/i.test(n)) return '💻';
    if (/energy|power|electric|renewable|solar/i.test(n)) return '⚡';
    if (/corruption|transparency|accountability/i.test(n)) return '🔍';
    if (/lifetime|achievement/i.test(n)) return '🏆';
    if (/trailblazer|pioneer|breakthrough/i.test(n)) return '🚀';
    if (/champion|outstanding|best/i.test(n)) return '🥇';
    return '🏆';
  }

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML.replace(/\"/g, '&quot;').replace(/'/g, '&#39;');
  }

  document.getElementById('category-search')?.addEventListener('input', () => {
    const q = document.getElementById('category-search').value.toLowerCase().trim();
    renderCategories(q ? allCategories.filter(c => c.category_name.toLowerCase().includes(q) || (c.description || '').toLowerCase().includes(q)) : allCategories);
  });

  // Preline dropdown sort handlers
  document.querySelectorAll('.sort-option').forEach(btn => {
    btn.addEventListener('click', () => {
      const sort = btn.dataset.sort;
      let sorted = [...allCategories];
      if (sort === 'name') sorted.sort((a, b) => a.category_name.localeCompare(b.category_name));
      else if (sort === 'nominees') sorted.sort((a, b) => (b.nominee_count || 0) - (a.nominee_count || 0));
      // 'index' keeps original order
      renderCategories(sorted);
      const dropdown = document.querySelector('.hs-dropdown');
      if (dropdown && window.HSDropdown) {
        const toggle = dropdown.querySelector('.hs-dropdown-toggle');
        const instance = window.HSDropdown.getInstance(toggle);
        if (instance) instance.close();
      }
    });
  });

  loadCategories();
</script>

