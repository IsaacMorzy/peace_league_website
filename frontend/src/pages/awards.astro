  }
  #categories-carousel {
    cursor: grab;
  }
  #categories-carousel:active {
    cursor: grabbing;
  }
  .carousel-dot {
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .carousel-dot:hover {
    background-color: rgba(var(--color-accent-rgb, 0 212 164), 0.4);
  }
</style>
