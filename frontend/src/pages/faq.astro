---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import { slugify } from "../lib/slugify";

const faqSections = [
  {
    title: "About Peace League Africa",
    icon: "🌍",
    questions: [
      { q: "What is Peace League Africa and when was it founded?", a: "Peace League Africa is a non-profit organisation founded in 2015 in Nairobi. We work in 12 East African countries to build peace through peace education, clean water access, healthcare outreach, youth mentorship, sustainable agriculture, and emergency relief." },
      { q: "Where do you work?", a: "We work in 12 countries across East Africa and the Great Lakes region: Kenya, Uganda, Tanzania, Rwanda, Burundi, South Sudan, Ethiopia, Somalia, DRC, Sudan, Zambia, and Malawi. Our country offices are in Nairobi (HQ), Kampala, Kigali, and Juba." },
      { q: "How are you funded and where do your funds go?", a: "We receive funding from individual donors (38% of budget), corporate partners (24%), foundation grants (30%), and institutional partnerships including the African Union (8%). 95 pence on every pound reaches programs — one of the lowest overhead ratios in our sector. Our financials are audited annually by an independent regional audit firm; full reports and partner agreements are public on /about." },
    ],
  },
  {
    title: "Our Programs",
    icon: "📚",
    questions: [
      { q: "What are your core programs?", a: "Six integrated programs: Peace Education (in 500 schools across 12 countries, 67% reduction in classroom violence), Clean Water Access (34 boreholes + 120 rainwater systems serving 80,000 people), Healthcare Outreach (4 mobile clinics serving 84 villages, zero maternal deaths in target areas), Youth Mentorship (500 mentees in 4-year cohorts, 73% less likely to join armed groups), Sustainable Agriculture (24,000 farming families, 60% yield increase), and Emergency Relief (12 water tankers + food distribution network)." },
      { q: "How do communities get selected for a program?", a: "Communities apply through our country offices, then we conduct a 6-week needs assessment with local partners. Selection criteria include conflict vulnerability, distance from government services, and demonstrated local leadership. We commit to 3-year minimum partnerships so impact lasts beyond any single project." },
      { q: "How do you measure impact?", a: "We partner with academic institutions (University of Nairobi, Makerere University) to run 3-year longitudinal studies. Our M&E framework tracks 47 indicators across inputs, outputs, outcomes, and long-term change. Annual impact reports are public on our website." },
    ],
  },
  {
    title: "Donations",
    icon: "💚",
    questions: [
      { q: "What percentage of my donation reaches programs?", a: "95%. 5% covers administration and fundraising — one of the lowest ratios in the East African non-profit sector. We publish quarterly financial breakdowns on our transparency page." },
      { q: "Can I donate in Kenyan Shillings?", a: "Yes. We accept KES, USD, EUR, and GBP via M-Pesa, Airtel Money, credit card, and bank transfer. M-Pesa is often the fastest for Kenyan donors — funds reach us within 30 seconds." },
      { q: "Is my donation tax-deductible?", a: "Donations over KES 1,000 are tax-deductible in Kenya under our NGO registration. We issue official receipts within 7 days. For UK and US donors, we partner with trusted intermediary charities that handle tax receipts." },
      { q: "Can I give a one-off gift or commit to monthly?", a: "Both. One-off gifts work through any of the channels above. Monthly commitments starting at KES 100/month unlock our Supporter Circle — quarterly impact updates, an annual field visit invitation, and voting on next-year's program priorities." },
    ],
  },
  {
    title: "Volunteering",
    icon: "🤲",
    questions: [
      { q: "What volunteer tracks do you offer?", a: "Three tracks: Field Volunteer (2-12 weeks on the ground in one of 12 countries), Remote Skills Volunteer (2-10 hours per week from anywhere — M&E, design, translation, legal review, research), and Chapter Lead (6+ months running a Peace League chapter in a diaspora city). Each track has its own application process — see /volunteer." },
      { q: "Do I need prior experience?", a: "No. We provide full training and ongoing support. What we look for is commitment, cultural humility, and willingness to learn. Specialist roles (medical, legal, M&E) do require relevant qualifications." },
      { q: "Can I volunteer if I'm under 18?", a: "Yes, through our Junior Ambassador programme (ages 14-17). It's a structured 6-month commitment focused on peer-to-peer peace education in your own school or community. Parental consent is required." },
    ],
  },
  {
    title: "Partnerships",
    icon: "🤝",
    questions: [
      { q: "Do you partner with corporates?", a: "Yes — Bronze (KES 50,000/yr), Silver (KES 250,000/yr — most popular), and Gold (KES 1,000,000/yr) tiers. Each tier includes co-branded programme sponsorship, full impact reporting, employee engagement opportunities, and field visits. See /partner for full perks." },
      { q: "Can my foundation give a restricted grant?", a: "Absolutely. Restricted grants are welcome for any of our six programs. We'll co-design the reporting schedule, impact indicators, and beneficiary stories to match your foundation's priorities. Average grant-processing time is 6 weeks." },
      { q: "How do you handle media partnerships?", a: "Our Communications team responds to media enquiries within one business day. We supply ready-to-publish photos, beneficiary interviews (with full consent), and verified impact data. For documentary partnerships, contact media@peaceleagueafrica.org." },
    ],
  },
];

const orgEmail = "info@peaceleagueafrica.org";
const orgPhone = "+254 700 000 000";
---

<Layout title="Frequently Asked Questions — Peace League Africa" description="Common questions about Peace League Africa's programs, donations, volunteering, and partnerships. 95 pence on the pound reaches programs. Six programs across 12 East African countries.">

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "url": "https://peaceleagueafrica.org/faq",
    "mainEntity": faqSections.flatMap((section) =>
      section.questions.map((qa) => ({
        "@type": "Question",
        "name": qa.q,
        "acceptedAnswer": { "@type": "Answer", "text": qa.a }
      }))
    )
  })} />

  <Navigation />

  <main id="main-content">
    <!-- Hero: flat per Slice-1 [baseline-ui] -->
    <section class="py-12 lg:py-16 bg-surface border-b border-hairline">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-accent/15 rounded-full text-accent-deep font-semibold text-sm mb-6">
          <span aria-hidden="true">❓</span> Frequently Asked Questions
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-ink mb-4 tracking-tight leading-[1.1]">
          Answers to your most-asked questions
        </h1>
        <p class="text-xl text-steel max-w-2xl mx-auto">
          How we work, where your money goes, and how to get involved. Still curious? Write to <a href={`mailto:${orgEmail}`} class="text-accent-deep underline hover:text-accent">{orgEmail}</a>.
        </p>
      </div>
    </section>

    <!-- Anchor nav -->
    <section class="py-6 px-4 sm:px-6 lg:px-8 bg-canvas border-b border-hairline">
      <div class="max-w-4xl mx-auto">
        <nav aria-label="FAQ sections" class="flex flex-wrap gap-2 justify-center">
          {faqSections.map((s) => (
            <a href={`#${slugify(s.title)}`} class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-surface border border-hairline text-sm text-steel hover:text-ink hover:border-accent/40 hover:bg-accent/5 transition-all">
              <span aria-hidden="true">{s.icon}</span>
              <span>{s.title}</span>
            </a>
          ))}
        </nav>
      </div>
    </section>

    <!-- Sections -->
    {faqSections.map((section) => (
      <section id={slugify(section.title)} class="py-section px-4 sm:px-6 lg:px-8 bg-canvas border-t border-hairline scroll-mt-24">
        <div class="max-w-4xl mx-auto">
          <div class="flex items-center gap-3 mb-8">
            <span class="text-3xl" aria-hidden="true">{section.icon}</span>
            <h2 class="text-heading-2 text-ink">{section.title}</h2>
          </div>
          <div class="space-y-4">
            {section.questions.map((qa) => (
              <details class="card-base p-5 group">
                <summary class="cursor-pointer font-semibold text-ink flex items-start gap-2 hover:text-accent-deep transition-colors">
                  <span class="flex-1">{qa.q}</span>
                  <svg class="w-5 h-5 text-steel mt-0.5 transition-transform group-open:rotate-180 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                  </svg>
                </summary>
                <p class="text-steel leading-relaxed mt-3 pt-3 border-t border-hairline">{qa.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    ))}

    <!-- Still have questions? -->
    <section class="py-section px-4 sm:px-6 lg:px-8 bg-surface border-t border-hairline">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-heading-3 text-ink mb-4">Still have questions?</h2>
        <p class="text-body-md text-steel mb-8">
          We respond to all enquiries within one business day. Email, phone, or contact form — pick what works for you.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href={`mailto:${orgEmail}`} class="btn btn-accent btn-large">Email us</a>
          <a href="/contact" class="btn btn-large border-2 border-hairline text-ink hover:border-accent hover:text-accent-deep transition-all">Contact form</a>
        </div>
      </div>
    </section>

    <!-- Cross-links -->
    <section class="py-10 bg-canvas border-t border-hairline">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="text-sm text-steel mb-4">You might also be interested in</p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/donate" class="inline-flex items-center px-5 py-2.5 rounded-full border border-hairline text-sm text-steel hover:text-ink hover:border-accent/40 hover:bg-accent/5 transition-all duration-200">Donate</a>
          <a href="/volunteer" class="inline-flex items-center px-5 py-2.5 rounded-full border border-hairline text-sm text-steel hover:text-ink hover:border-accent/40 hover:bg-accent/5 transition-all duration-200">Volunteer</a>
          <a href="/partner" class="inline-flex items-center px-5 py-2.5 rounded-full border border-hairline text-sm text-steel hover:text-ink hover:border-accent/40 hover:bg-accent/5 transition-all duration-200">Partner With Us</a>
          <a href="/about" class="inline-flex items-center px-5 py-2.5 rounded-full border border-hairline text-sm text-steel hover:text-ink hover:border-accent/40 hover:bg-accent/5 transition-all duration-200">About</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
