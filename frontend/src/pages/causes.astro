---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import causes from "../lib/causes-data.json";
import { formatKes, progressPct } from "../lib/format";
import { slugify } from "../lib/slugify";

const causeSlugs = Object.fromEntries(
  causes.map((c) => [c.name, slugify(c.name)])
);

const categories = ["All", "Education", "Youth", "Community", "Health", "Water", "Agriculture", "Emergency", "Training", "Event"];

const totalRaised = causes.reduce((acc, c) => acc + (c.raised_amount || 0), 0);
const totalDonors = causes.reduce((acc, c) => acc + (c.donors_count || 0), 0);
---

<Layout title="Our Causes — Peace League Africa" description="Browse 25 active causes driving Peace League Africa's work across East Africa: peace education, youth empowerment, healthcare, clean water, sustainable agriculture, and community reconciliation. Pick yours and donate today.">

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Our Causes — Peace League Africa",
    "url": "https://peaceleagueafrica.org/causes",
    "description": "Browse 25 active causes supporting Peace League Africa's mission across East Africa.",
    "isPartOf": { "@type": "WebSite", "name": "Peace League Africa", "url": "https://peaceleagueafrica.org" },
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": causes.length,
      "itemListElement": causes.map((c, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "url": `https://peaceleagueafrica.org/causes/${causeSlugs[c.name]}`,
        "name": c.title
      }))
    }
  })} />

  <Navigation />

  <main id="main-content">
    <!-- Hero: flat per Slice-1 [baseline-ui] -->
    <section class="py-12 lg:py-16 bg-surface border-b border-hairline">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-accent/15 rounded-full text-accent-deep font-semibold text-sm mb-6">
          <span aria-hidden="true">🎯</span> {causes.length} active causes
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-ink mb-4 tracking-tight leading-[1.1]">
          Pick your cause. <span class="text-accent">Power the change.</span>
        </h1>
        <p class="text-xl text-steel max-w-2xl mx-auto">
          Every cause on this page is a real programme running today across 12 East African countries — from peace-education classrooms to clean-water boreholes, women's empowerment, climate resilience, and youth mentorship.
        </p>
      </div>
    </section>

    <!-- Aggregate stats -->
    <section class="py-8 px-4 sm:px-6 lg:px-8 bg-canvas border-b border-hairline">
      <div class="max-w-7xl mx-auto">
        <dl class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
          <div>
            <dt class="text-xs text-steel uppercase tracking-wider mb-1">Active causes</dt>
            <dd class="text-3xl font-bold text-accent">{causes.length}</dd>
          </div>
          <div>
            <dt class="text-xs text-steel uppercase tracking-wider mb-1">Raised (lifetime)</dt>
            <dd class="text-3xl font-bold text-accent">{formatKes(totalRaised)}</dd>
          </div>
          <div>
            <dt class="text-xs text-steel uppercase tracking-wider mb-1">Donors contributing</dt>
            <dd class="text-3xl font-bold text-accent">{totalDonors.toLocaleString()}</dd>
          </div>
          <div>
            <dt class="text-xs text-steel uppercase tracking-wider mb-1">Categories</dt>
            <dd class="text-3xl font-bold text-accent">{categories.length - 1}</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- Category filter pills (interactive) -->
    <section class="py-6 px-4 sm:px-6 lg:px-8 bg-surface border-b border-hairline">
      <div class="max-w-7xl mx-auto text-center">
        <div role="group" aria-label="Filter causes by category" class="flex flex-wrap gap-2 justify-center">
          {categories.map((cat) => (
            <button
              type="button"
              class={`inline-flex items-center px-4 py-1.5 rounded-full text-xs font-semibold border transition-colors ${cat === "All" ? "bg-primary text-on-primary border-primary" : "bg-canvas text-steel border-hairline hover:text-ink hover:border-accent/40"}`}
              data-filter-cat={cat}
              aria-pressed={cat === "All" ? "true" : "false"}
            >
              {cat}
            </button>
          ))}
        </div>
        <p class="text-xs text-steel mt-2" data-cause-count aria-live="polite" aria-atomic="true">Showing all {causes.length} causes.</p>
      </div>
    </section>

    <!-- Cause cards grid -->
    <section class="py-section px-4 sm:px-6 lg:px-8 bg-canvas">
      <div class="max-w-7xl mx-auto">
        <div id="causes-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-start">
          {causes.map((cause) => {
            const pct = progressPct(cause.raised_amount || 0, cause.goal_amount || 1);
            return (
              <article
                class="card-base p-0 overflow-hidden flex flex-col"
                data-cause-card
                data-category={cause.category}
                id={slugify(cause.name)}
              >
                <div class="h-44 relative overflow-hidden bg-surface">
                  <img
                    src={cause.image}
                    alt={cause.title}
                    width="400"
                    height="200"
                    class="w-full h-full object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="badge-tag absolute top-3 left-3">{cause.category}</span>
                </div>
                <div class="p-6 flex flex-col flex-1 gap-3">
                  <h3 class="text-lg font-semibold text-ink">{cause.title}</h3>
                  <p class="text-sm text-steel leading-relaxed flex-1">{cause.description}</p>
                  <div class="border-t border-hairline pt-3">
                    <div class="flex justify-between text-xs text-steel mb-1.5">
                      <span class="font-semibold text-accent-deep">{formatKes(cause.raised_amount || 0)}</span>
                      <span>of {formatKes(cause.goal_amount || 0)} ({pct}%)</span>
                    </div>
                    <div
                      class="w-full bg-hairline rounded-full h-2 overflow-hidden"
                      role="progressbar"
                      aria-valuenow={pct}
                      aria-valuemin="0"
                      aria-valuemax="100"
                      aria-label={`${cause.title} funding progress`}
                    >
                      <div class="bg-accent h-2 rounded-full transition-all duration-700" style={`width: ${pct}%`}></div>
                    </div>
                    <p class="text-xs text-steel mt-1">{cause.donors_count || 0} supporters already in.</p>
                  </div>
                  <div class="flex flex-col gap-2 pt-2">
                    <a href={`/causes/${causeSlugs[cause.name]}`} class="btn btn-primary btn-large w-full justify-center">
                      View Cause Details
                    </a>
                    <a href={`/donate?cause=${encodeURIComponent(cause.name || "")}`} class="btn btn-secondary btn-large w-full justify-center">
                      Donate Now
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Empty state when no categories match (shown via :empty selector) -->
    <p hidden data-cause-empty role="status" class="text-center text-steel py-12">No causes in this category yet — check back soon.</p>

    <!-- CTA -->
    <section class="py-section px-4 sm:px-6 lg:px-8 bg-surface border-t border-hairline">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-heading-3 text-ink mb-4">Sponsor a cause today</h2>
        <p class="text-body-md text-steel mb-8">
          Every cause is a programme running across our 12 countries. Your donation — large or small — ripples into classrooms, clinics, water points, and farm fields across East Africa.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/donate" class="btn btn-accent btn-large">Donate now</a>
          <a href="/volunteer" class="btn btn-large border-2 border-hairline text-ink hover:border-accent hover:text-accent-deep transition-all">Volunteer</a>
          <a href="/fundraise" class="btn btn-large border-2 border-hairline text-ink hover:border-accent hover:text-accent-deep transition-all">Run a fundraiser</a>
        </div>
      </div>
    </section>

    <!-- Cross-links -->
    <section class="py-10 bg-canvas border-t border-hairline">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="text-sm text-steel mb-4">You might also be interested in</p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/donate" class="inline-flex items-center px-5 py-2.5 rounded-full border border-hairline text-sm text-steel hover:text-ink hover:border-accent/40 hover:bg-accent/5 transition-all duration-200">Donate</a>
          <a href="/volunteer" class="inline-flex items-center px-5 py-2.5 rounded-full border border-hairline text-sm text-steel hover:text-ink hover:border-accent/40 hover:bg-accent/5 transition-all duration-200">Volunteer</a>
          <a href="/events" class="inline-flex items-center px-5 py-2.5 rounded-full border border-hairline text-sm text-steel hover:text-ink hover:border-accent/40 hover:bg-accent/5 transition-all duration-200">Events</a>
          <a href="/about" class="inline-flex items-center px-5 py-2.5 rounded-full border border-hairline text-sm text-steel hover:text-ink hover:border-accent/40 hover:bg-accent/5 transition-all duration-200">About</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    // Category filter — progressive enhancement. Filter is interactive
    // without a full reload by toggling display on data-cause-card entries
    // based on the data-category attribute.
    (function() {
      const buttons = document.querySelectorAll('[data-filter-cat]');
      const cards = document.querySelectorAll('[data-cause-card]');
      const countEl = document.querySelector('[data-cause-count]');
      const emptyEl = document.querySelector('[data-cause-empty]');
      if (!buttons.length || !cards.length) return;

      function applyFilter(cat) {
        let visible = 0;
        cards.forEach((card) => {
          if (cat === 'All' || card.dataset.category === cat) {
            card.style.display = '';
            visible++;
          } else {
            card.style.display = 'none';
          }
        });
        if (countEl) {
          countEl.textContent = cat === 'All'
            ? `Showing all ${cards.length} causes.`
            : `Showing ${visible} cause(s) in ${cat}.`;
        }
        if (emptyEl) {
          emptyEl.hidden = visible > 0;
        }
      }

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const cat = btn.dataset.filterCat || 'All';
          buttons.forEach((b) => {
            const isActive = b.dataset.filterCat === cat;
            b.classList.toggle('bg-primary', isActive);
            b.classList.toggle('text-on-primary', isActive);
            b.classList.toggle('border-primary', isActive);
            b.classList.toggle('bg-canvas', !isActive);
            b.classList.toggle('text-steel', !isActive);
            b.classList.toggle('border-hairline', !isActive);
            b.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          });
          applyFilter(cat);
        });
      });
    })();
  </script>
</Layout>
