---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const pages = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About Us', desc: 'Mission, history, values, and impact' },
  { href: '/team', label: 'Our Team' },
  { href: '/causes', label: 'All Causes' },
  { href: '/causes?category=Education', label: 'Peace Education' },
  { href: '/causes?category=Health', label: 'Healthcare' },
  { href: '/causes?category=Water', label: 'Clean Water' },
  { href: '/causes?category=Youth', label: 'Youth Programs' },
  { href: '/causes?category=Agriculture', label: 'Agriculture' },
  { href: '/donate', label: 'Donate' },
  { href: '/volunteer', label: 'Volunteer' },
  { href: '/partner', label: 'Partner With Us' },
  { href: '/careers', label: 'Careers' },
  { href: '/events', label: 'Events' },
  { href: '/blog', label: 'Blog' },
  { href: '/testimonials', label: 'Testimonials' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/contact', label: 'Contact Us' },
  { href: '/awards', label: 'Awards', desc: 'Browse award categories and vote' },
  { href: '/awards/nominate', label: 'Awards — Nominate' },
  { href: '/awards/results', label: 'Awards — Results' },
  { href: '/awards/tickets', label: 'Awards — Get Tickets', desc: 'Purchase gala tickets' },
  { href: '/faq', label: 'FAQ' },
  { href: '/fundraise', label: 'Fundraise' },
  { href: '/privacy', label: 'Privacy Policy' },
  { href: '/terms', label: 'Terms of Service' },
];
---

<Layout title="Sitemap" description="Complete sitemap of Peace League Africa — find every page on our website.">
  <Navigation />
  
  <main id="main-content">
    <section class="py-12 lg:py-16 bg-surface border-b border-hairline">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-semibold leading-[1.10] tracking-tight text-ink">Sitemap</h1>
        <p class="mt-4 text-lg text-steel">Everything on Peace League Africa, all in one place.</p>
      </div>
    </section>
