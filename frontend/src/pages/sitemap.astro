---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const pages = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About Us', desc: 'Mission, history, values, and impact' },
  { href: '/team', label: 'Our Team' },
  { href: '/causes', label: 'All Causes' },
  { href: '/causes?category=Education', label: 'Peace Education' },
  { href: '/causes?category=Health', label: 'Healthcare' },
  { href: '/causes?category=Water', label: 'Clean Water' },
  { href: '/causes?category=Youth', label: 'Youth Programs' },
  { href: '/causes?category=Agriculture', label: 'Agriculture' },
  { href: '/donate', label: 'Donate' },
  { href: '/volunteer', label: 'Volunteer' },
  { href: '/partner', label: 'Partner With Us' },
  { href: '/careers', label: 'Careers' },
  { href: '/events', label: 'Events' },
  { href: '/blog', label: 'Blog' },
  { href: '/testimonials', label: 'Testimonials' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/contact', label: 'Contact Us' },
  { href: '/awards', label: 'Awards', desc: 'Browse award categories and vote' },
  { href: '/awards/nominate', label: 'Awards — Nominate' },
  { href: '/awards/results', label: 'Awards — Results' },
  { href: '/awards/tickets', label: 'Awards — Get Tickets', desc: 'Purchase gala tickets' },
  { href: '/faq', label: 'FAQ' },
  { href: '/fundraise', label: 'Fundraise' },
  { href: '/privacy', label: 'Privacy Policy' },
  { href: '/terms', label: 'Terms of Service' },
];
---

<Layout title="Sitemap" description="Complete sitemap of Peace League Africa — find every page on our website.">
  <Navigation />
  
  <main id="main-content">
    <section class="hero-inner grain-overlay text-white py-4 lg:py-8">
      <!-- Ambient orbs -->
      <div class="orb-float orb-float--1" style="top:-100px;right:-100px;" aria-hidden="true"></div>
      <div class="orb-float orb-float--2" style="bottom:-80px;left:-80px;" aria-hidden="true"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <h1 class="animate-in fade-in slide-in-from-bottom-4 duration-700 text-3xl sm:text-4xl lg:text-5xl font-semibold leading-[1.10] tracking-tight">Sitemap</h1>
        <p class="mt-4 animate-in fade-in slide-in-from-bottom-4 duration-700 delay-150 text-lg text-white/70">Everything on Peace League Africa, all in one place.</p>
      </div>
      <div class="geometric-shapes" aria-hidden="true">
        <span class="float-shape float-shape--a" style="width:160px;height:160px;top:0;left:5%;background:radial-gradient(circle,rgba(0,212,164,0.2),transparent 70%);"></span>
        <span class="float-shape float-shape--b" style="width:100px;height:100px;top:10%;right:8%;background:radial-gradient(circle,rgba(245,158,11,0.15),transparent 70%);"></span>
        <span class="float-shape--diamond float-shape--a" style="width:70px;height:70px;bottom:25%;left:12%;border:2px solid rgba(0,212,164,0.15);background:transparent;"></span>
        <span class="float-shape float-shape--c" style="width:250px;height:250px;bottom:-15%;right:-5%;background:radial-gradient(circle,rgba(0,212,164,0.06),transparent 70%);"></span>
      </div>
      <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
