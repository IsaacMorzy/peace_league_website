---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import { slugify } from "../lib/slugify";

const testimonials = [
  {
    name: "Amina Osei",
    role: "Teacher, Accra, Ghana",
    program: "Peace Education",
    quote: "Peace League Africa transformed how I teach conflict resolution in my classroom. The curriculum gave my students tools to resolve disagreements peacefully, and I have seen bullying drop by more than half in just one term.",
    rating: 5
  },
  {
    name: "Joseph Kiprop",
    role: "Community Leader, Turkana, Kenya",
    program: "Clean Water",
    quote: "Before the clean water project, our women walked 12 kilometers each day for water. Now my daughter has time to attend school, and our community is healthier than ever. Peace League did not just bring water — they brought hope.",
    rating: 5
  },
  {
    name: "Grace Mukamana",
    role: "Youth Program Graduate, Kigali, Rwanda",
    program: "Youth Mentorship",
    quote: "The youth leadership workshop gave me the confidence to start a peace club at my university. We now have 200 members from 15 different countries, all committed to building bridges instead of walls.",
    rating: 5
  },
  {
    name: "Dr. Samuel Tadesse",
    role: "Healthcare Partner, Addis Ababa, Ethiopia",
    program: "Healthcare Outreach",
    quote: "Partnering with Peace League on community health initiatives has been remarkable. Their understanding of local contexts and genuine community engagement sets them apart from other organizations I have worked with.",
    rating: 5
  },
  {
    name: "Nkechi Okonkwo",
    role: "Donor, Lagos, Nigeria",
    program: "Stewardship",
    quote: "I wanted my giving to make a real difference. What I love about Peace League is their transparency — I can see exactly how my donations are used and the tangible impact they create in communities across Africa.",
    rating: 5
  },
  {
    name: "Pierre Habimana",
    role: "Reconciliation Facilitator, Bujumbura, Burundi",
    program: "Community Reconciliation",
    quote: "After decades of conflict, trust does not come easily. Peace League's patient, community-led approach has helped former adversaries sit at the same table and find common ground. Change is possible.",
    rating: 5
  }
];

const stats = [
  { value: "12", label: "Countries" },
  { value: "500+", label: "Communities" },
  { value: "50,000+", label: "Lives impacted" },
  { value: "95%", label: "Program funding" }
];

const programImpact = [
  { name: "Peace Education", metric: "67% drop in classroom violence", active_in: "Kenya, Uganda, Rwanda, S. Sudan" },
  { name: "Clean Water", metric: "80,000 served across 34 boreholes", active_in: "Turkana, Samburu, West Pokot" },
  { name: "Healthcare Outreach", metric: "Zero maternal deaths in target areas", active_in: "Karamoja + Teso (Uganda)" },
  { name: "Youth Mentorship", metric: "73% less likely to join armed groups", active_in: "Northern Uganda + S. Sudan" }
];
---

<Layout title="Testimonials — Peace League Africa" description="Stories from communities, partners, and volunteers working with Peace League Africa across 12 East African countries. Real voices from the field — peace education, clean water, mentorship, healthcare, stewardship, reconciliation.">

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Testimonials — Peace League Africa",
    "url": "https://peaceleagueafrica.org/testimonials",
    "description": "Stories from communities, partners, and volunteers working with Peace League Africa across 12 East African countries.",
    "isPartOf": { "@type": "WebSite", "name": "Peace League Africa", "url": "https://peaceleagueafrica.org" },
    "review": testimonials.map((t) => ({
      "@type": "Review",
      "reviewBody": t.quote,
      "author": { "@type": "Person", "name": t.name, "jobTitle": t.role },
      "reviewRating": { "@type": "Rating", "ratingValue": t.rating, "bestRating": 5 }
    }))
  })} />

  <Navigation />

  <main id="main-content">
    <!-- Hero: flat per Slice-1 [baseline-ui] -->
    <section class="py-12 lg:py-16 bg-surface border-b border-hairline">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-accent/15 rounded-full text-accent-deep font-semibold text-sm mb-6">
          <span aria-hidden="true">💬</span> Stories from the field
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-ink mb-4 tracking-tight leading-[1.1]">
          What people say
        </h1>
        <p class="text-xl text-steel max-w-2xl mx-auto">
          Teachers, farmers, health workers, and youth share how Peace League Africa's work has shaped their communities and their own lives.
        </p>
      </div>
    </section>

    <!-- Aggregate stats -->
    <section class="py-8 px-4 sm:px-6 lg:px-8 bg-canvas border-b border-hairline">
      <div class="max-w-7xl mx-auto">
        <dl class="grid grid-cols-2 lg:grid-cols-4 gap-6 text-center">
          {stats.map((s) => (
            <div>
              <dt class="text-3xl md:text-4xl font-bold text-accent mb-1">{s.value}</dt>
              <dd class="text-xs text-steel uppercase tracking-wider">{s.label}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Voices from the field -->
    <section class="py-section px-4 sm:px-6 lg:px-8 bg-surface">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-heading-2 text-ink mb-4">Voices from the field</h2>
          <p class="text-body-md text-steel max-w-2xl mx-auto">
            Six testimonies — each tied to a specific programme. Real people, real programmes, real impact.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {testimonials.map((t) => (
            <article class="card-base p-6 flex flex-col gap-4" data-testimonial id={`testimonial-${slugify(t.name)}`}>
              <div class="flex items-center gap-1" aria-label={`Rated ${t.rating} out of 5 stars`}>
                {Array.from({ length: t.rating }).map(() => (
                  <svg class="w-4 h-4 text-accent" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.957a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.367 2.447a1 1 0 00-.364 1.118l1.287 3.957c.299.921-.756 1.688-1.539 1.118l-3.366-2.447a1 1 0 00-1.176 0l-3.367 2.447c-.783.57-1.838-.197-1.539-1.118l1.287-3.957a1 1 0 00-.364-1.118L2.063 9.384c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.95-.69l1.286-3.957z"/>
                  </svg>
                ))}
              </div>
              <blockquote class="text-base text-ink leading-relaxed flex-1">
                {t.quote}
              </blockquote>
              <footer class="pt-4 border-t border-hairline">
                <cite class="not-italic font-semibold text-ink block">{t.name}</cite>
                <p class="text-xs text-steel">{t.role}</p>
                <span class="badge-tag mt-2">{t.program}</span>
              </footer>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Programs behind the voices -->
    <section class="py-section px-4 sm:px-6 lg:px-8 bg-canvas border-t border-hairline">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-10">
          <h2 class="text-heading-3 text-ink mb-4">Programs behind the voices</h2>
          <p class="text-body-md text-steel max-w-2xl mx-auto">
            Each testimony corresponds to a specific programme. Every programme has a measurable audit headline.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {programImpact.map((p) => (
            <div class="card-base p-6 flex flex-col gap-2" id={slugify(p.name)}>
              <span class="badge-tag self-start">{p.name}</span>
              <p class="text-lg font-semibold text-ink mt-1">{p.metric}</p>
              <p class="text-sm text-steel">Active in: {p.active_in}</p>
              <a href={`/causes#${slugify(p.name)}`} class="text-sm text-accent-deep underline hover:text-accent mt-2">See all causes in this program →</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-section px-4 sm:px-6 lg:px-8 bg-surface border-t border-hairline">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-heading-3 text-ink mb-4">Add your story</h2>
        <p class="text-body-md text-steel mb-8">
          Partner with our work, volunteer, or donate — your contribution shapes the next testimonial.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/donate" class="btn btn-accent btn-large">Donate</a>
          <a href="/volunteer" class="btn btn-large border-2 border-hairline text-ink hover:border-accent hover:text-accent-deep transition-all">Volunteer</a>
          <a href="/partner" class="btn btn-large border-2 border-hairline text-ink hover:border-accent hover:text-accent-deep transition-all">Partner</a>
        </div>
      </div>
    </section>

    <!-- Cross-links -->
    <section class="py-10 bg-canvas border-t border-hairline">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="text-sm text-steel mb-4">You might also be interested in</p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/causes" class="inline-flex items-center px-5 py-2.5 rounded-full border border-hairline text-sm text-steel hover:text-ink hover:border-accent/40 hover:bg-accent/5 transition-all duration-200">Causes</a>
          <a href="/about" class="inline-flex items-center px-5 py-2.5 rounded-full border border-hairline text-sm text-steel hover:text-ink hover:border-accent/40 hover:bg-accent/5 transition-all duration-200">About</a>
          <a href="/team" class="inline-flex items-center px-5 py-2.5 rounded-full border border-hairline text-sm text-steel hover:text-ink hover:border-accent/40 hover:bg-accent/5 transition-all duration-200">Team</a>
          <a href="/blog" class="inline-flex items-center px-5 py-2.5 rounded-full border border-hairline text-sm text-steel hover:text-ink hover:border-accent/40 hover:bg-accent/5 transition-all duration-200">Blog</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
