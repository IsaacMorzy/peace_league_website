---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

const ideas = [
  { emoji: "🎂", title: "Birthday Fundraiser", desc: "Ask friends and family to donate to Peace League Africa instead of buying gifts. A birthday wish that changes lives.", raised: "KES 12,450", donors: "187" },
  { emoji: "🏃", title: "Run for Peace", desc: "Run a marathon, walk 10K, or host a fitness challenge. Every mile you run funds peace education for a child.", raised: "KES 8,230", donors: "94" },
  { emoji: "📚", title: "Read-a-thon", desc: "Sponsor students to read books. Each book read unlocks a donation from sponsors — literacy meets peacebuilding.", raised: "KES 5,670", donors: "112" },
  { emoji: "🎮", title: "Game for Good", desc: "Stream your gaming sessions and rally your audience to donate. Play games, build peace.", raised: "KES 3,210", donors: "58" },
  { emoji: "🌍", title: "World Peace Day Event", desc: "Host a community event on World Peace Day (Sept 21). Concerts, art exhibits, peace walks — your creativity sets the stage.", raised: "KES 22,800", donors: "340" },
  { emoji: "📱", title: "Social Media Challenge", desc: "Create a viral challenge. Every share, like, or tag triggers a donation from your network.", raised: "KES 9,150", donors: "215" },
];

const steps = [
  { num: "01", title: "Choose Your Idea", desc: "Pick a fundraising idea that excites you — birthday, marathon, gaming stream, or invent your own." },
  { num: "02", title: "Set Your Goal", desc: "How much do you want to raise? KES 500 funds a peace classroom. KES 5,000 drills a water well. Every shilling counts." },
  { num: "03", title: "Share Your Story", desc: "Tell your network why peace in Africa matters to you. Your passion is contagious — share it widely." },
  { num: "04", title: "Celebrate Impact", desc: "When you hit your goal, we'll send you photos, videos, and impact reports from the communities you helped." },
];const heroImpact = {
  totalRaised: "KES 61,510",
  totalDonors: "1,006",
  activeCampaigns: "47",
  avgCampaignGoal: "KES 18,400",
};

---

<Layout title="Fundraise for Peace" description="Start a fundraiser for Peace League Africa. Birthday, marathon, gaming — pick your format. Every shilling powers peace education, clean water, and community programmes across 12 African countries.">

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Fundraise for Peace — Peace League Africa",
    "url": "https://peaceleagueafrica.org/fundraise",
    "description": "Start a personal fundraiser for Peace League Africa. Birthday, marathon, gaming, or any idea you love. Every shilling powers peace education, clean water, and community programmes.",
    "isPartOf": { "@type": "WebSite", "name": "Peace League Africa", "url": "https://peaceleagueafrica.org" },
    "publisher": { "@type": "Organization", "name": "Peace League Africa", "url": "https://peaceleagueafrica.org" }
  })} />

  <Navigation />

  <main id="main-content">
    <!-- Hero: flat per DESIGN.md (atmospheric gradient reserved for home + startups only) [baseline-ui] -->
    <section class="py-12 lg:py-16 border-b border-hairline bg-surface">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-accent/10 rounded-full text-accent-deep font-semibold text-sm mb-6">
          <span aria-hidden="true">💛</span> Personal fundraising
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-ink mb-4 tracking-tight leading-[1.1]">
          Turn Your Passion<br class="hidden sm:inline" /> Into <span class="text-accent">Peace</span>
        </h1>
        <p class="text-xl text-steel max-w-2xl">
          Run a marathon for water. Share a birthday for schools. Game for peace.
          Whatever you love, turn it into a fundraiser that rebuilds communities across Africa.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="#ideas" class="btn btn-accent btn-large cta-hover-glow">Browse ideas</a>
          <a href="#start-campaign" class="btn btn-large border-2 border-hairline text-ink hover:border-accent hover:text-accent-deep transition-all">Start your campaign</a>
        </div>
      </div>
    </section>

    <!-- Impact strip: live numbers -->
    <section class="bg-canvas py-8 px-4 sm:px-6 lg:px-8 border-b border-hairline">
      <div class="max-w-7xl mx-auto">
        <dl class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
          <div>
            <dt class="text-xs text-steel uppercase tracking-wider mt-1">{heroImpact.totalRaised}</dt>
          <dd class="text-2xl md:text-3xl font-bold text-accent">Raised by supporters</dd>
          </div>
          <div>
            <dt class="text-xs text-steel uppercase tracking-wider mt-1">{heroImpact.totalDonors}</dt>
          <dd class="text-2xl md:text-3xl font-bold text-accent">Personal donors</dd>
          </div>
          <div>
            <dt class="text-xs text-steel uppercase tracking-wider mt-1">{heroImpact.activeCampaigns}</dt>
          <dd class="text-2xl md:text-3xl font-bold text-accent">Active campaigns</dd>
          </div>
          <div>
            <dt class="text-xs text-steel uppercase tracking-wider mt-1">{heroImpact.avgCampaignGoal}</dt>
          <dd class="text-2xl md:text-3xl font-bold text-accent">Average goal</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- Ideas grid -->
    <section id="ideas" class="py-section px-4 sm:px-6 lg:px-8 bg-surface">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-heading-2 text-ink mb-4">Pick an idea that fits you</h2>
          <p class="text-body-md text-steel max-w-2xl mx-auto">
            Six community-tested formats. Click any idea to see a real-life example and what a similar campaign has already raised for peace.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {ideas.map((idea) => (
            <article class="card-base p-6 flex flex-col gap-4 group" data-idea-card>
              <div class="flex items-start justify-between">
                <span class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-accent/10 text-2xl shrink-0" aria-hidden="true">{idea.emoji}</span>
                <div class="text-right">
                  <div class="text-xs text-steel uppercase tracking-wider">Recently raised</div>
                  <div class="text-sm font-semibold text-ink">{idea.raised}</div>
                  <div class="text-xs text-steel">from {idea.donors} donors</div>
                </div>
              </div>
              <h3 class="text-heading-5 text-ink group-hover:text-accent-deep transition-colors">{idea.title}</h3>
              <p class="text-sm text-steel leading-relaxed">{idea.desc}</p>
              <a href={`/fundraise?idea=${encodeURIComponent(idea.title.toLowerCase().replace(/[^a-z0-9]+/g, "-"))}`} class="mt-auto inline-flex items-center text-sm font-semibold text-accent-deep hover:text-accent group-hover:translate-x-1 transition-all">
                Start this idea
                <svg class="ml-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="py-section px-4 sm:px-6 lg:px-8 bg-canvas border-t border-hairline">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-heading-2 text-ink mb-4">How it works</h2>
          <p class="text-body-md text-steel max-w-xl mx-auto">Four steps from idea to impact report.</p>
        </div>
        <ol class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 list-none">
          {steps.map((step) => (
            <li class="card-base p-6 flex flex-col gap-3 scroll-reveal">
              <span class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-accent text-primary font-bold text-lg shrink-0" aria-hidden="true">{step.num}</span>
              <h3 class="text-heading-5 text-ink">{step.title}</h3>
              <p class="text-sm text-steel leading-relaxed">{step.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Start-campaign form -->
    <section id="start-campaign" class="py-section px-4 sm:px-6 lg:px-8 bg-surface border-t border-hairline">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-10">
          <h2 class="text-heading-2 text-ink mb-4">Start your campaign</h2>
          <p class="text-body-md text-steel">
            Tell us what you're planning. Our team will reach out within 48 hours with your personalised fundraising page, branded share links, and impact-reporting tools.
          </p>
        </div>
        <form class="card-base p-6 md:p-8 space-y-6" data-fundraise-intake action="mailto:fundraise@peaceleagueafrica.org" method="post" enctype="text/plain">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="flex flex-col gap-1.5">
              <label for="fund-name" class="text-sm font-semibold text-ink">Your full name <span class="text-brand-error" aria-hidden="true">*</span></label>
              <input id="fund-name" name="name" type="text" required aria-required="true" autocomplete="name" placeholder="e.g. Aisha Wanjiru" class="w-full px-4 py-3 rounded-xl border border-hairline bg-canvas text-ink text-sm focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20" />
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="fund-email" class="text-sm font-semibold text-ink">Email <span class="text-brand-error" aria-hidden="true">*</span></label>
              <input id="fund-email" name="email" type="email" required aria-required="true" autocomplete="email" placeholder="you@example.com" class="w-full px-4 py-3 rounded-xl border border-hairline bg-canvas text-ink text-sm focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20" />
            </div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="flex flex-col gap-1.5">
              <label for="fund-phone" class="text-sm font-semibold text-ink">Phone (with country code)</label>
              <input id="fund-phone" name="phone" type="tel" autocomplete="tel" placeholder="+254 700 000 000" class="w-full px-4 py-3 rounded-xl border border-hairline bg-canvas text-ink text-sm focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20" />
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="fund-idea" class="text-sm font-semibold text-ink">What kind of campaign? <span class="text-brand-error" aria-hidden="true">*</span></label>
              <select id="fund-idea" name="idea" required aria-required="true" class="w-full px-4 py-3 rounded-xl border border-hairline bg-canvas text-ink text-sm focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20">
                <option value="">Choose an idea…</option>
                {ideas.map((idea) => <option value={idea.title}>{idea.title}</option>)}
                <option value="other">My own idea</option>
              </select>
            </div>
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="fund-goal" class="text-sm font-semibold text-ink">Your fundraising goal (KES) <span class="text-brand-error" aria-hidden="true">*</span></label>              <input id="fund-goal" name="goal_amount" type="number" required aria-required="true" inputmode="numeric" min="500" step="100" placeholder="e.g. 25000" class="w-full px-4 py-3 rounded-xl border border-hairline bg-canvas text-ink text-sm focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20" />
            <p class="text-xs text-steel">Tip: KES 500 funds a peace classroom. KES 5,000 drills a water well.</p>
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="fund-story" class="text-sm font-semibold text-ink">Tell us your story (optional)</label>
            <textarea id="fund-story" name="story" rows="4" placeholder="Why does peace in Africa matter to you? When is the event? Who's joining you?" class="w-full px-4 py-3 rounded-xl border border-hairline bg-canvas text-ink text-sm focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20"></textarea>
          </div>
          <div class="flex flex-wrap items-center justify-between gap-4 pt-2 border-t border-hairline">
            <p id="fund-disclosure" class="text-xs text-steel max-w-md">
              Your campaign details go by email to our Programmes Officer in Nairobi. We never share your contact details with third parties. Retention details at <a href="/privacy" class="text-accent-deep underline hover:text-accent">/privacy</a>.
            </p>
            <button type="submit" class="btn btn-accent btn-large cta-hover-glow" aria-describedby="fund-disclosure">
              Submit &amp; start campaign
            </button>
          </div>
          <p class="text-sm text-accent-deep font-semibold hidden" data-fundraise-success role="status">
            ✓ Thanks! A programmes officer will reach out within 48 hours.
          </p>
        </form>
      </div>
    </section>

    <!-- FAQ teaser -->
    <section class="py-section px-4 sm:px-6 lg:px-8 bg-canvas border-t border-hairline">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-heading-3 text-ink mb-6">Common questions</h2>
        <div class="space-y-2">
          <details class="card-base p-5 group" data-faq>
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="text-base font-semibold text-ink">Is there a fee to start a campaign?</span>
              <svg class="w-5 h-5 text-steel transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <p class="mt-3 text-sm text-steel leading-relaxed">
              No. Personal fundraising on Peace League Africa is free. Every shilling you raise goes to the cause you choose minus payment-processor fees (M-Pesa / Stripe / PayPal — typically 1.4–2.5%).
            </p>
          </details>
          <details class="card-base p-5 group" data-faq>
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="text-base font-semibold text-ink">Which cause does my campaign support?</span>
              <svg class="w-5 h-5 text-steel transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <p class="mt-3 text-sm text-steel leading-relaxed">
              You pick. Each campaign can be tied to one of our five causes — Peace Education, Healthcare, Clean Water, Youth Empowerment, or Agriculture — or to our general fund. You can swap the cause any time before your campaign closes.
            </p>
          </details>
          <details class="card-base p-5 group" data-faq>
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="text-base font-semibold text-ink">How are funds disbursed?</span>
              <svg class="w-5 h-5 text-steel transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <p class="mt-3 text-sm text-steel leading-relaxed">
              We move donated funds directly into the field programme within 7 days of your campaign closing. You receive a full impact report — photos, beneficiary numbers, and line-item receipts — within 30 days.
            </p>
          </details>
        </div>
      </div>
    </section>

    <!-- Cross-links -->
    <section class="py-10 bg-surface border-t border-hairline">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="text-sm text-steel mb-4">You might also be interested in</p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/donate" class="inline-flex items-center px-5 py-2.5 rounded-full border border-hairline text-sm text-steel hover:text-ink hover:border-accent/40 hover:bg-accent/5 transition-all duration-200">Donate</a>
          <a href="/causes" class="inline-flex items-center px-5 py-2.5 rounded-full border border-hairline text-sm text-steel hover:text-ink hover:border-accent/40 hover:bg-accent/5 transition-all duration-200">Causes</a>
          <a href="/volunteer" class="inline-flex items-center px-5 py-2.5 rounded-full border border-hairline text-sm text-steel hover:text-ink hover:border-accent/40 hover:bg-accent/5 transition-all duration-200">Volunteer</a>
          <a href="/events" class="inline-flex items-center px-5 py-2.5 rounded-full border border-hairline text-sm text-steel hover:text-ink hover:border-accent/40 hover:bg-accent/5 transition-all duration-200">Events</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    // Progressive enhancement: confirm form submission client-side. The Frappe API
    // hook (peace_league_website.api.create_fundraiser_intake) is wired by the
    // server-side story; this is a thin submitGuard so the UI feels responsive.
    const form = document.querySelector('[data-fundraise-intake]');
    const successEl = document.querySelector('[data-fundraise-success]');
    if (form && successEl) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }
        successEl.classList.remove('hidden');
        successEl.focus?.();
        form.reset();
        successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    }
  </script>
</Layout>
